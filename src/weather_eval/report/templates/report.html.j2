  {key:"slope", label:"回归斜率",    axis:"斜率",         scale:true,  dec:2},
];
const PRECIP_METRICS = [
  {key:"ts",    label:"晴雨 TS 评分",  axis:"TS(0~1)",        scale:false, dec:2},
  {key:"ets",   label:"晴雨 ETS 评分", axis:"ETS",             scale:false, dec:2},
  {key:"acc",   label:"晴雨准确率",    axis:"准确率(%)",       scale:false, dec:1},
  {key:"pod",   label:"命中率 POD",    axis:"命中率(%)",       scale:false, dec:1},
  {key:"far",   label:"空报率 FAR",    axis:"空报率(%)",       scale:false, dec:1},
  {key:"miss",  label:"漏报率",        axis:"漏报率(%)",       scale:false, dec:1},
