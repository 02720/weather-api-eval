/* ---------------- 预报 vs 实况（最近 72 小时，可切换站点/模型） ----------------
 * 注意：这张图有"空态 ↔ 有数据"的往复（切换站点时某站可能暂无实况），
 * 因此不能复用 makeChart：空态要销毁 ECharts 实例并恢复容器 class/内容，
 * 否则再切回有数据的站点时，echarts.init 幂等复用已脱离 DOM 的旧实例，
 * 图会永远停留在"暂无数据"的提示上。 */
try {
  const selS = document.getElementById("tsStation");
  const selM = document.getElementById("tsModel");
  report.meta.stations.forEach(s => { const o=document.createElement("option"); o.value=s; o.text=stationOf(s); selS.appendChild(o); });
  rankedModels.forEach(m => { const o=document.createElement("option"); o.value=m; o.text=labelOf(m); selM.appendChild(o); });
  const tsEl = document.getElementById("chartTs");
  let tsChart = null;   // 常驻唯一实例；空态时 dispose 置空
  function drawTs() {
    const s = selS.value, m = selM.value;
    const ts = report.timeseries[s] || {};
    const obs = ts.obs || [];
    const fcst = (ts.models && ts.models[m]) || [];
    if (!obs.length) {                       // —— 空态：安全销毁，允许之后恢复 ——
      if (tsChart) { tsChart.dispose(); tsChart = null; }
      tsEl.className = "chart-empty";
      tsEl.textContent = "该站暂无实况数据（数据积累中）";
      return;
    }
    if (tsEl.className !== "chart tall") {   // —— 从空态恢复容器 ——
      tsEl.className = "chart tall";
      tsEl.textContent = "";
    }
    if (!tsChart) { tsChart = echarts.init(tsEl); charts.push(tsChart); }
    tsChart.setOption({
      tooltip:{trigger:"axis"},
      legend:{top:0},
      grid:{left:50, right:60, top:42, bottom:56},
      xAxis:{type:"category", data:obs.map(p => fmtT(p.t)), axisLabel:{rotate:45}},
      yAxis:[{type:"value", name:"气温°C", scale:true},
             {type:"value", name:"降水mm", position:"right", splitLine:{show:false}}],
      series:[
        {name:"实况气温", type:"line", data:obs.map(p=>p.temp), itemStyle:{color:"#0f172a"}, lineStyle:{width:2.5}, symbol:"circle"},
        {name:labelOf(m)+" 预报气温", type:"line", data:fcst.map(p=>p?p.temp:null), itemStyle:{color:colorOf(m)}, lineStyle:{width:2, type:"dashed"}},
        {name:labelOf(m)+" 预报降水", type:"bar", yAxisIndex:1, data:fcst.map(p=>p?p.rain:null), itemStyle:{color:"#93c5fd"}}
      ]
    }, {notMerge:true});                     // 切换站点/模型时整体替换，避免残留旧序列
  }
  selS.onchange = drawTs; selM.onchange = drawTs;
  drawTs();
} catch(e) { console.error("timeseries", e); }

/* ---------------- 每日 × 模型 温度准确率热力图（行按排行榜排序） ---------------- */
try {
  const cells = report.heatmap || [];
  if (!cells.length) {
    emptyNote("chartHeat", "数据积累中，过几天再来就有热力图了");
  } else {
    const dates = [...new Set(cells.map(c => c.date))];
    const ms = rankedModels;
    const data = cells.filter(c => ms.indexOf(c.model) !== -1)
                      .map(c => [dates.indexOf(c.date), ms.indexOf(c.model), c.acc2, c.n]);
    const el = document.getElementById("chartHeat");
    // 行数多时容器相应加高，避免每行被压扁到不可读
    el.style.height = Math.max(360, 19 * ms.length + 150) + "px";
    makeChart("chartHeat", {
      tooltip:{position:"top", formatter:p =>
        `${dates[p.data[0]]} · ${labelOf(ms[p.data[1]])}<br>温度准确率：` +
        (p.data[2]===null ? "样本不足" : fmt(p.data[2])+"%") + `（样本 ${p.data[3]||0}）`},
      grid:{left:110, right:24, top:14, bottom:64},
      xAxis:{type:"category", data:dates.map(d=>d.slice(5)), axisLabel:{rotate:45}},
      // 类目轴默认自下而上绘制，不加 inverse 时榜首会沉底、与"第一名在最上"的说明相反
      yAxis:{type:"category", data:ms.map(labelOf), inverse:true,
             axisLabel:{width:100, overflow:"truncate"}},
      visualMap:{min:0, max:100, dimension:2, calculable:true, orient:"horizontal", left:"center", bottom:4,
                 text:["准","翻车"], inRange:{color:["#ef4444","#fbbf24","#22c55e"]}},
      series:[{type:"heatmap", data,
               itemStyle:{borderColor:"#fff", borderWidth:1},
               emphasis:{itemStyle:{shadowBlur:6, shadowColor:"rgba(0,0,0,.3)"}}}]
    });
  }
} catch(e) { console.error("heatmap", e); }

/* ---------------- 分站对比：24h 温度准确率 / 晴雨 TS ---------------- */
try {
  const stations = report.meta.stations;
  metricLineChart({el:"chartStation", selId:"stationMetricSel",
    metrics:[{key:"temp",   label:"温度 ±2°C 准确率", axis:"温度准确率(%)", scale:false, dec:1},
             {key:"precip", label:"晴雨 TS 评分",      axis:"晴雨 TS 评分",  scale:false, dec:2}],
    x:stations.map(stationOf), def:"temp",
    valueFn:(m, i, k) => {
      const d = (report.per_station[stations[i]] || {})[m];
      if (!d) return null;
      return k === "temp" ? (d.temp || {}).acc2 : (d.precip || {}).ts;
    }});
} catch(e) { console.error("stationBar", e); }

/* ---------------- 进阶区：折叠内的图表等首次展开时再初始化 ----------------
 * ECharts 在隐藏容器里初始化量不到宽高（会得到 0），所以 lazy-init。 */
let advancedInited = false;
function initAdvanced() {
  if (advancedInited) return;
  advancedInited = true;
  try {
    const offs = Object.keys(report.temp_daily[rankedModels[0]] || {});
    const xo = offs.map(o => "第" + o.replace("d","") + "天");
    compareLineChart({el:"chartTempDailyMax", x:xo,
      getVal:(m, i) => { const d = report.temp_daily[m][offs[i]];
                         return d && d.max ? d.max.acc2 : null; },
      yName:"最高气温准确率(%)", opts:{scale:false, valueFmt:v => fmt(v, 1)}});
    compareLineChart({el:"chartTempDailyMin", x:xo,
      getVal:(m, i) => { const d = report.temp_daily[m][offs[i]];
                         return d && d.min ? d.min.acc2 : null; },
      yName:"最低气温准确率(%)", opts:{scale:false, valueFmt:v => fmt(v, 1)}});
    // 按天降水：与逐小时降水共用指标全集
    metricLineChart({el:"chartPrecipDaily", selId:"precipDailySel",
      metrics:PRECIP_METRICS, x:xo, def:"ts",
      valueFn:(m, i, k) => { const d = report.precip_daily[m][offs[i]]; return d ? d[k] : null; }});

    // 分级降水分 TS：x = 24h 累计雨级，日偏移可选（切偏移只刷新数据）
    const GRADE_LEVS = ["+1","+2","+3","+4","+5","+6"];
    const GRADE_LABELS = ["≥0.1mm","≥10mm","≥25mm","≥50mm","≥100mm","≥250mm"];
    const offSel = document.getElementById("gradedOffsetSel");
    offs.forEach(o => { const op=document.createElement("option"); op.value=o;
      op.text="第"+o.replace("d","")+"天"; offSel.appendChild(op); });
    const gradedCfg = {el:"chartPrecipGraded", x:GRADE_LABELS,
      getVal:(m, i) => {
        const d = report.precip_daily[m][offSel.value];
        return d && d.graded && d.graded[GRADE_LEVS[i]] ? d.graded[GRADE_LEVS[i]].ts : null;
      },
      yName:"分级 TS(0~1)", opts:{scale:false, valueFmt:v => fmt(v, 2)}};
    compareLineChart(gradedCfg);
    offSel.onchange = () => refreshCompare(gradedCfg);

    // 72h 逐小时精细曲线
    const hours = Object.keys(report.temp_lead_curve[rankedModels[0]] || {});
    metricLineChart({el:"chartTempLead", selId:"leadMetricSel",
      metrics:[{key:"rmse", label:"温度 RMSE(°C)", axis:"RMSE(°C)", scale:true, dec:2},
               {key:"acc2", label:"温度 ±2°C 准确率(%)", axis:"准确率(%)", scale:false, dec:1}],
      x:hours.map(h => h.replace("h","")), xName:"提前量(小时)", def:"rmse",
      valueFn:(m, i, k) => { const d = report.temp_lead_curve[m][hours[i]]; return d ? d[k] : null; }});
  } catch(e) { console.error("advanced", e); }
  try { buildDetailTables(); } catch(e) { console.error("detailTables", e); }
}
try {
  document.getElementById("advanced").addEventListener("toggle", initAdvanced);
} catch(e) { console.error("advanced toggle", e); }

/* ---------------- 明细表（纯 HTML，无需等展开；首展时构建） ---------------- */
const f2 = v => (v===null||v===undefined) ? "—" : Number(v).toFixed(2);
const f1 = v => (v===null||v===undefined) ? "—" : Number(v).toFixed(1);
const pf = v => (v===null||v===undefined) ? "—" : Number(v).toFixed(1)+"%";

function modelCell(m) {
  return `<td class="l sticky"><span class="dot" style="background:${colorOf(m)}"></span>${labelOf(m)}</td>`;
}

function buildDetailTables() {
  const HOURLY_GRADE_LABELS = {1:"小", 2:"中", 3:"大", 4:"暴", 5:"大暴"};
  // ---- 表① 逐小时口径 ----
  const buckets = Object.keys(report.temp_hourly[rankedModels[0]] || {});
  const bSel = document.getElementById("hourlyBucketSel");
  buckets.forEach(b => { const o=document.createElement("option"); o.value=b;
    o.text="提前"+b.replace("d","")+"天"; bSel.appendChild(o); });
  function tableHourly() {
    const b = bSel.value;
    let html = '<table><thead><tr>' +
      '<th class="l sticky" rowspan="2">模型</th><th rowspan="2">n温</th><th rowspan="2">n降</th>' +
      '<th class="g" colspan="9">温度(°C)</th><th class="g" colspan="8">降水 · 晴雨</th>' +
      '<th class="g" colspan="3">雨量误差(mm)</th><th class="g" colspan="5">分级TS · 1h雨强</th></tr>' +
      '<tr><th>RMSE</th><th>MAE</th><th>MBE</th><th>±1°C</th><th>±2°C</th><th>r</th><th>斜率</th><th>RSS</th><th>χ²</th>' +
      '<th>准确率</th><th>POD</th><th>空报</th><th>漏报</th><th>TS</th><th>ETS</th><th>BIAS</th><th>空报频率</th>' +
      '<th>RMSE</th><th>MAE</th><th>MBE</th>' +
      Object.values(HOURLY_GRADE_LABELS).map(l => `<th>${l}</th>`).join("") +
      '</tr></thead><tbody>';
    rankedModels.forEach(m => {
      const t = report.temp_hourly[m][b] || {};
      const p = report.precip_hourly[m][b] || {};
      const g = p.graded || {};
      const gs = lv => (g[lv] ? f2(g[lv].ts) : "—");
      html += `<tr>${modelCell(m)}<td class="num">${t.n||0}</td><td class="num">${p.n||0}</td>` +
        `<td>${f2(t.rmse)}</td><td>${f2(t.mae)}</td><td>${f2(t.mbe)}</td><td>${pf(t.acc1)}</td><td>${pf(t.acc2)}</td>` +
        `<td>${f2(t.r)}</td><td>${f2(t.slope)}</td><td>${f2(t.rss)}</td><td>${f2(t.chi2)}</td>` +
        `<td>${pf(p.acc)}</td><td>${pf(p.pod)}</td><td>${pf(p.far)}</td><td>${pf(p.miss)}</td>` +
        `<td>${f2(p.ts)}</td><td>${f2(p.ets)}</td><td>${f2(p.bias)}</td><td>${pf(p.farate)}</td>` +
        `<td>${f2(p.rmse)}</td><td>${f2(p.mae)}</td><td>${f2(p.mbe)}</td>` +
        `<td>${gs("1")}</td><td>${gs("2")}</td><td>${gs("3")}</td><td>${gs("4")}</td><td>${gs("5")}</td></tr>`;
    });
    html += '</tbody></table>';
    document.getElementById("detailTableHourly").innerHTML = html;
  }
  bSel.onchange = tableHourly;
  tableHourly();

  // ---- 表② 按天口径 ----
  const offs = Object.keys(report.temp_daily[rankedModels[0]] || {});
  const oSel = document.getElementById("dailyOffsetSel");
  offs.forEach(o => { const op=document.createElement("option"); op.value=o;
    op.text="第"+o.replace("d","")+"天"; oSel.appendChild(op); });
  const DAILY_GRADE_LABELS = {"+1":"≥0.1","+2":"≥10","+3":"≥25","+4":"≥50","+5":"≥100","+6":"≥250"};
  function tableDaily() {
    const o = oSel.value;
    let html = '<table><thead><tr>' +
      '<th class="l sticky" rowspan="2">模型</th><th rowspan="2">n温</th><th rowspan="2">n降</th>' +
      '<th class="g" colspan="2">日最高(°C)</th><th class="g" colspan="2">日最低(°C)</th>' +
      '<th class="g" colspan="8">日降水 · 晴雨</th><th class="g" colspan="3">雨量误差(mm)</th>' +
      '<th class="g" colspan="6">分级TS · 24h累计(mm)</th></tr>' +
      '<tr><th>±2°C</th><th>RMSE</th><th>±2°C</th><th>RMSE</th>' +
      '<th>准确率</th><th>POD</th><th>空报</th><th>漏报</th><th>TS</th><th>ETS</th><th>BIAS</th><th>空报频率</th>' +
      '<th>RMSE</th><th>MAE</th><th>MBE</th>' +
      Object.values(DAILY_GRADE_LABELS).map(l => `<th>${l}</th>`).join("") +
      '</tr></thead><tbody>';
    rankedModels.forEach(m => {
      const td = report.temp_daily[m][o] || {};
      const mx = td.max || {}, mn = td.min || {};
      const p = report.precip_daily[m][o] || {};
      const g = p.graded || {};
      const gs = lv => (g[lv] ? f2(g[lv].ts) : "—");
      html += `<tr>${modelCell(m)}<td class="num">${Math.max(mx.n||0, mn.n||0)}</td><td class="num">${p.n||0}</td>` +
        `<td>${pf(mx.acc2)}</td><td>${f2(mx.rmse)}</td><td>${pf(mn.acc2)}</td><td>${f2(mn.rmse)}</td>` +
        `<td>${pf(p.acc)}</td><td>${pf(p.pod)}</td><td>${pf(p.far)}</td><td>${pf(p.miss)}</td>` +
        `<td>${f2(p.ts)}</td><td>${f2(p.ets)}</td><td>${f2(p.bias)}</td><td>${pf(p.farate)}</td>` +
        `<td>${f2(p.rmse)}</td><td>${f2(p.mae)}</td><td>${f2(p.mbe)}</td>` +
        `<td>${gs("+1")}</td><td>${gs("+2")}</td><td>${gs("+3")}</td><td>${gs("+4")}</td><td>${gs("+5")}</td><td>${gs("+6")}</td></tr>`;
    });
    html += '</tbody></table>';
    document.getElementById("detailTableDaily").innerHTML = html;
  }
  oSel.onchange = tableDaily;
  tableDaily();
}

/* ---------------- 启动：选源器 + 排行榜聚焦态 ----------------
 * 排行榜表格在上方模块内自渲染（切时效/排序/搜索都在那里），此处不再重复初始化。 */
try { renderPickers(); } catch(e) { console.error("cmpPicker", e); }
try { renderRankFocus(); } catch(e) { console.error("rankFocus", e); }
</script>
</body>
</html>
