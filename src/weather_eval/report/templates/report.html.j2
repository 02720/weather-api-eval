<!DOCTYPE html>
{# ============================================================================
  天气预报准确度检验报告模板（2026-08 重设计，2026-08-29 排行榜表格化改版）

  设计原则：
  1. 结论先行 —— 打开页面第一眼就看到"谁家预报最准"，而不是一堆术语和图表；
  2. 榜单优先 —— 多家预报源不靠"一条线一个颜色"硬挤：主视图是**表格式排行榜**，
     每个提前量档（提前 1~16 天）一张榜单，读者自选时效、点列名排序、搜索过滤；
     每行附"得分随时效衰减"迷你走势线。折线图退居辅助（趋势图 + 聚焦对比图），
     "战场带 + 聚焦线"三层结构保留（灰带 = 全体范围，彩色粗线 = 自选聚焦 ≤5 家）。
  3. 处处有注释 —— 每张图表配"💡 怎么看"，页面底部内置"名词小词典"，
     读者不需要任何气象/统计背景；
  4. 一页即全部 —— 本页（index.html）每次运行覆盖更新，永远展示"本月至今"
     的累积结果；历史月份见页脚"月度归档"。
  5. 多指标加权综合分 —— 温度 7 项 + 降水 6 项指标加权入分（评分构成表在
     排行榜区可展开；权重定义在 evaluate.py，模板只负责展示，单一数据源）。

  页面结构（自上而下）：
    Hero 横幅            标题 + 一句话结论（提前 1 天榜冠军）
    🌱 30秒看懂本报告    5 个核心概念的小白解释
    🏅 预报源排行榜      表格式主视图：切提前天数 / 列排序 / 搜索 / 名次走势
    📉 得分随时效衰减    综合/温度/降水三个维度的得分趋势（榜单的趋势版）
    🌡️ 气温预报          指标下拉：准确率/误差/相关系数 随时效
    🌧️ 降水预报          指标下拉：TS/ETS/POD/FAR/BIAS/雨量误差 随时效
    🔍 预报 vs 实况      最近 72 小时叠加对比图（可切换站点/模型）
    🗓️ 每日热力图        哪天准、哪天翻车一目了然（行按排行榜排序）
    📍 分站对比          同一预报在不同站点的表现
    🧪 进阶数据          折叠区：按天评估 / 分级降水 / 精细曲线 / 全指标明细表×2
    📖 名词小词典        所有术语的大白话解释
    🗂️ 归档 + 机制说明   月度归档链接、报告生成机制
============================================================================ #}
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="自动把多家天气预报与气象站实况对比，用数据告诉你谁家预报更准。每天自动更新。">
<title>{{ title }}</title>
<!-- ECharts 使用仓库内本地副本（避免 CDN 不可达）。注意：此处 document.body 尚未
     解析（head 内为 null），失败提示必须等 DOM 就绪后再插入，否则横幅自身会抛错。 -->
<script src="{{ base }}vendor/echarts.min.js"></script>
<script>
window.addEventListener("DOMContentLoaded", function () {
  if (typeof echarts === "undefined") {
    document.body.insertAdjacentHTML("afterbegin",
      '<div style="background:#dc2626;color:#fff;padding:10px 16px;text-align:center">图表库加载失败，页面中的数值结论与明细表不受影响。</div>');
  }
});
</script>
<style>
  /* ---------- 设计变量：全站统一的配色/圆角/阴影 ---------- */
  :root {
    --bg:#f1f5f9; --card:#ffffff; --line:#e2e8f0; --text:#0f172a; --muted:#64748b;
    --blue:#2563eb; --blue-dark:#1e3a8a; --sky:#0ea5e9; --green:#16a34a;
    --amber:#d97706; --red:#dc2626; --gold:#f59e0b;
    --radius:16px; --shadow:0 1px 3px rgba(15,23,42,.06),0 4px 14px rgba(15,23,42,.05);
  }
  * { box-sizing:border-box; }
  /* author 样式（如 .chart-empty 的 display:flex）会压过 UA 的 [hidden]{display:none}，
     这里统一把 hidden 属性 restoring 成最强语义，防止"hidden 了却还显示"的空态常驻 */
  [hidden] { display:none !important; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--bg); color:var(--text);
         font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB",
                     "Microsoft YaHei","Segoe UI",Roboto,sans-serif; line-height:1.6; }

  /* ---------- Hero 横幅：渐变 + 装饰光斑 ---------- */
  .hero { position:relative; overflow:hidden; color:#fff;
          background:linear-gradient(135deg,var(--blue-dark) 0%,var(--blue) 55%,var(--sky) 100%); }
  .hero::before, .hero::after { content:""; position:absolute; border-radius:50%;
          background:rgba(255,255,255,.08); }
  .hero::before { width:420px; height:420px; right:-120px; top:-160px; }
  .hero::after  { width:260px; height:260px; left:-80px; bottom:-120px; }
  .hero-inner { position:relative; max-width:1080px; margin:0 auto; padding:44px 20px 40px; }
  .badge { display:inline-block; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.28);
           border-radius:999px; padding:4px 14px; font-size:13px; margin-bottom:14px; }
  .hero h1 { margin:0 0 10px; font-size:34px; letter-spacing:1px; }
  .subtitle { margin:0 0 18px; font-size:15.5px; opacity:.94; max-width:720px; }
  .chips { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:4px; }
  .chip { background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22);
          border-radius:10px; padding:5px 12px; font-size:13px; }
  /* 冠军横幅：Hero 内的玻璃拟态卡片，全页最重要的"一句话结论" */
  .champion { margin-top:18px; background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.3);
              backdrop-filter:blur(6px); border-radius:14px; padding:14px 18px; font-size:15.5px; }
  .champion b { font-size:19px; }
  .champion .sub { font-size:13px; opacity:.9; margin-top:4px; }

  /* ---------- 主体布局与通用卡片 ---------- */
  .wrap { max-width:1080px; margin:0 auto; padding:8px 18px 40px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
          padding:22px 22px; margin:18px 0; box-shadow:var(--shadow); }
  .card > h2 { font-size:19px; margin:0 0 4px; }
  .card .desc { color:var(--muted); font-size:13.5px; margin:2px 0 14px; }
  /* "💡 怎么看"提示条：每张图下面的小白导读 */
  .hint { background:#eff6ff; border-left:4px solid var(--blue); border-radius:8px;
          color:#1e40af; font-size:13px; padding:9px 14px; margin:10px 0 0; }
  .hint b { color:#1e3a8a; }

  /* ---------- 30 秒看懂：核心概念卡 ---------- */
  .guide-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px; }
  .guide-item { border:1px solid var(--line); border-radius:12px; padding:14px 16px; background:#f8fafc; }
  .guide-item .t { font-weight:700; font-size:14.5px; margin-bottom:6px; }
  .guide-item .d { font-size:13px; color:#334155; }

  /* ---------- 排行榜：表格式主视图 ---------- */
  .lb-controls { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:4px 0 10px; }
  .lb-buckets { display:flex; gap:6px; overflow-x:auto; padding:2px; flex:1; min-width:220px; }
  .lb-buckets::-webkit-scrollbar { height:6px; }
  .lb-buckets::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:3px; }
  .lb-pill { flex:none; border:1px solid var(--line); background:#fff; border-radius:999px;
             padding:5px 11px; font-size:12.5px; cursor:pointer; color:#334155;
             display:inline-flex; align-items:center; gap:5px; }
  .lb-pill i { font-style:normal; font-size:10.5px; color:var(--muted);
               font-variant-numeric:tabular-nums; }
  .lb-pill:hover { border-color:var(--blue); color:var(--blue); }
  .lb-pill.on { background:var(--blue); border-color:var(--blue); color:#fff; }
  .lb-pill.on i { color:#dbeafe; }
  .lb-pill.empty { color:#94a3b8; border-style:dashed; }
  .lb-search { max-width:210px; flex:none; }
  .lb-scroll { overflow-x:auto; border:1px solid var(--line); border-radius:12px;
               box-shadow:0 1px 2px rgba(15,23,42,.04); }
  .lb-table { font-size:12.5px; min-width:1000px; }
  .lb-table th, .lb-table td { border:none; border-bottom:1px solid var(--line);
                               padding:7px 8px; white-space:nowrap; }
  .lb-table thead th { background:#f1f5f9; font-weight:600; color:#334155; }
  .lb-table thead th[data-key] { cursor:pointer; user-select:none; }
  .lb-table thead th[data-key]:hover { color:var(--blue); }
  .lb-table thead th .ind { color:var(--blue); font-size:9.5px; }
  .lb-table .num { text-align:right; font-variant-numeric:tabular-nums; }
  .lb-table th.num { text-align:right; }
  /* 名次列 + 源名列吸顶左贴，横向滚动不丢行名（复合列宽 = 前列宽之和） */
  .lb-table .c-rank { position:sticky; left:0; z-index:1; width:52px; text-align:center; }
  .lb-table .c-name { position:sticky; left:52px; z-index:1; min-width:190px; }
  .lb-table td.c-rank, .lb-table td.c-name { background:#fff; }
  .lb-table th.c-rank { border-right:none; }
  .lb-table td.c-rank, .lb-table th.c-rank { border-right:2px solid var(--line);
                                             background-clip:padding-box; }
  .lb-table td.c-name { border-right:2px solid var(--line); background-clip:padding-box; }
  .lb-table td.c-name .fam { font-size:11px; margin-right:2px; }
  .lb-table td.c-name .id { display:block; font-size:10.5px; color:var(--muted); }
  .lb-table td.lb-rank { font-weight:700; color:#475569; }
  /* 当前时效综合最优行：金底 + 👑；样本不足行整体降调 */
  /* 当前时效综合最优行：金底 + 👑；样本不足行整体降调
     （一律 background-color：background 简写会重置 background-image，
     连带抹掉综合分列的底纹条） */
  .lb-table tr.lb-first td { background-color:#fffbeb; }
  .lb-table tr.lb-first td.c-rank, .lb-table tr.lb-first td.c-name { background-color:#fffbeb; }
  .lb-table tr.lb-first .c-name b { color:#b45309; }
  .lb-table tr.lb-none td { color:#94a3b8; }
  .lb-table tr:hover td { background-color:#f8fafc; }
  .lb-table tr.lb-first:hover td { background-color:#fef3c7; }
  .lb-table tr:hover td.c-rank, .lb-table tr:hover td.c-name { background-color:#f8fafc; }
  /* 综合分列：底纹条长度 = 分数，一眼看出梯队 */
  .lb-table td.lb-pri { font-weight:700; font-size:13px;
    background-image:linear-gradient(90deg,#dbeafe,#bfdbfe); background-repeat:no-repeat;
    background-position:left center; background-size:var(--w,0%) 62%; }
  .lb-table td.lb-pri .na { font-size:11px; font-weight:400; }
  .lb-table td.c-spark { width:122px; padding:4px 6px; }
  .lb-table td.c-spark svg { display:block; width:110px; height:32px; }
  .lb-table td.c-act { text-align:right; }
  .lb-n { color:#64748b; font-size:11.5px; }

  /* ---------- 评分构成折叠表 ---------- */
  .lb-weights { margin-top:14px; border:1px solid var(--line); border-radius:12px;
                background:#f8fafc; }
  .lb-weights > summary { cursor:pointer; list-style:none; padding:11px 14px;
                          font-size:13px; color:#334155; font-weight:600; }
  .lb-weights > summary::-webkit-details-marker { display:none; }
  .lb-weights > summary::after { content:"▸"; float:right; color:var(--muted);
                                 font-weight:400; }
  .lb-weights[open] > summary::after { content:"▾"; }
  .lb-weights-body { padding:0 14px 14px; }
  .lb-weights-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(330px,1fr));
                     gap:4px 18px; }
  .lb-weights h4 { margin:12px 0 6px; font-size:13.5px; }
  .lb-weights table { font-size:12px; background:#fff; }
  .lb-why { font-size:12px; color:var(--muted); margin:8px 0 0; line-height:1.7; }

  /* ---------- 图表容器与控制条（指标下拉 + 前8/全部分段开关） ---------- */
  .chart { width:100%; height:360px; margin-top:6px; }
  .chart.tall { height:420px; }
  .chart-empty { display:flex; align-items:center; justify-content:center; height:200px;
                 color:var(--muted); background:#f8fafc; border:1px dashed var(--line);
                 border-radius:12px; font-size:13.5px; }
  .chart-controls { display:flex; flex-wrap:wrap; align-items:center; gap:10px;
                    margin:4px 0 8px; }
  .chart-controls label { font-size:13px; color:#334155; }
  select { padding:6px 10px; border:1px solid var(--line); border-radius:9px; font-size:13px;
           background:#fff; margin:0 2px; max-width:220px; }
  .seg { display:inline-flex; border:1px solid var(--line); border-radius:9px; overflow:hidden; }
  .seg button { border:none; background:#fff; color:var(--muted); font-size:12.5px;
                padding:6px 12px; cursor:pointer; }
  .seg button + button { border-left:1px solid var(--line); }
  .seg button.on { background:var(--blue); color:#fff; }

  /* ---------- 选源器：聚焦对比源的统一入口，全页多张图共享同一份状态 ---------- */
  .cmp-mount { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .cmp-btn { border:1px solid var(--line); background:#fff; border-radius:9px;
             padding:6px 12px; font-size:12.5px; cursor:pointer; color:var(--text); }
  .cmp-btn b { color:var(--blue); font-variant-numeric:tabular-nums; }
  .cmp-btn.none { color:var(--muted); }
  .cmp-btn:hover { border-color:var(--blue); }
  .cmp-pack { font-size:12.5px; color:#334155; display:inline-flex;
              align-items:center; gap:5px; cursor:pointer; user-select:none; }
  .cmp-panel { width:100%; border:1px solid var(--line); border-radius:12px;
               background:#f8fafc; padding:12px 14px; }
  .cmp-presets { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .cmp-presets button { border:1px solid var(--line); background:#fff; border-radius:8px;
                        padding:4px 10px; font-size:12.5px; cursor:pointer; }
  .cmp-presets button:hover { border-color:var(--blue); color:var(--blue); }
  .cmp-search { flex:1; min-width:150px; max-width:none; margin:0; }
  .cmp-fam { margin-top:9px; }
  .cmp-fam-name { font-size:12px; color:var(--muted); font-weight:600; margin-bottom:6px; }
  .cmp-chips { display:flex; flex-wrap:wrap; gap:6px; }
  .cmp-chip { display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line);
              background:#fff; border-radius:999px; padding:4px 10px; font-size:12.5px;
              cursor:pointer; color:var(--text); }
  .cmp-chip i { font-style:normal; font-size:10.5px; color:var(--muted);
                font-variant-numeric:tabular-nums; }
  .cmp-chip:hover { border-color:var(--blue); }
  .cmp-chip.on { background:var(--blue); border-color:var(--blue); color:#fff; }
  .cmp-chip.on i { color:#dbeafe; }
  .cmp-msg { font-size:12px; color:var(--muted); margin-top:10px; }

  /* ---------- 排行榜行内聚焦按钮（表格行 + 选源器共用同一状态） ---------- */
  .rank-focus { border:1px solid var(--line); background:#fff; border-radius:999px;
                font-size:11.5px; padding:3px 10px; cursor:pointer; color:var(--muted);
                white-space:nowrap; }
  .rank-focus:hover { border-color:var(--blue); color:var(--blue); }
  .rank-focus.on { background:var(--blue); border-color:var(--blue); color:#fff; }

  /* ---------- 进阶折叠区 ---------- */
  details.card { padding:0; overflow:hidden; }
  details.card > summary { cursor:pointer; list-style:none; padding:20px 22px;
                           font-size:17px; font-weight:700; }
  details.card > summary::-webkit-details-marker { display:none; }
  details.card > summary::after { content:"▸ 展开"; float:right; font-size:13px;
                                  color:var(--muted); font-weight:400; }
  details.card[open] > summary::after { content:"▾ 收起"; }
  details.card .body { padding:0 22px 22px; border-top:1px solid var(--line); }
  details.card h3 { font-size:15.5px; margin:20px 0 4px; }

  /* ---------- 明细表：模型名列吸顶左贴，横向滚动不丢行名 ---------- */
  table { border-collapse:collapse; width:100%; font-size:12px; }
  th,td { border:1px solid var(--line); padding:5px 7px; text-align:center; white-space:nowrap; }
  th { background:#f1f5f9; }
  th.g { background:#e8eefb; }
  td.l,th.l { text-align:left; }
  th.sticky, td.sticky { position:sticky; left:0; background:#fff; z-index:1;
                         border-right:2px solid var(--line); }
  th.sticky { background:#f1f5f9; }
  .dot { display:inline-block; width:9px; height:9px; border-radius:50%;
         margin-right:6px; vertical-align:1px; }
  .num { font-variant-numeric:tabular-nums; }

  /* ---------- 名词小词典 ---------- */
  .glossary { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
              gap:4px 28px; margin:0; }
  .glossary > div { padding:9px 0; border-bottom:1px dashed var(--line); }
  .glossary dt { font-weight:700; font-size:13.5px; }
  .glossary dd { margin:2px 0 0; font-size:12.5px; color:#475569; }

  /* ---------- 归档链接与页脚 ---------- */
  .archive-list { display:flex; flex-wrap:wrap; gap:10px; margin:6px 0 0; }
  .archive-list a { display:inline-block; border:1px solid var(--line); border-radius:10px;
                    padding:8px 16px; color:var(--blue); text-decoration:none; font-size:14px;
                    background:#f8fafc; }
  .archive-list a:hover { border-color:var(--blue); background:#eff6ff; }
  .steps { margin:6px 0 0; padding-left:0; list-style:none; counter-reset:step; }
  .steps li { position:relative; padding:6px 0 6px 40px; font-size:13.5px; color:#334155;
              counter-increment:step; }
  .steps li::before { content:counter(step); position:absolute; left:0; top:7px;
                      width:24px; height:24px; border-radius:50%; background:var(--blue);
                      color:#fff; font-size:13px; font-weight:700; text-align:center; line-height:24px; }
  footer { text-align:center; color:var(--muted); font-size:12.5px; padding:10px 18px 36px; }
  a { color:var(--blue); }
  .back-home { display:inline-block; margin-bottom:4px; color:#dbeafe; font-size:13px; text-decoration:none; }
  .back-home:hover { text-decoration:underline; }

  @media (max-width:640px) {
    .hero h1 { font-size:26px; }
    .card { padding:18px 16px; }
    .chart { height:300px; }
    select { max-width:160px; }
  }
</style>
</head>
<body>

{% set lb1 = (report.leaderboards or {}).get('1d', []) %}
{% set champ = lb1[0] if (lb1 and lb1[0].score is not none) else none %}
{# 数值格式化宏：None（样本不足）统一显示为 — #}
{% macro pct(v) %}{{ '—' if v is none else '%.1f%%'|format(v) }}{% endmacro %}
{% macro num(v, d=2) %}{{ '—' if v is none else ('%.' ~ d ~ 'f')|format(v) }}{% endmacro %}

<!-- ==================== Hero：标题 + 一句话结论 ==================== -->
<header class="hero">
  <div class="hero-inner">
    {% if report.meta.is_monthly %}
    <a class="back-home" href="{{ base }}index.html">← 返回本月实时报告</a><br>
    <div class="badge">🗂️ 月度归档 · 数据已冻结</div>
    {% else %}
    <div class="badge">🤖 自动检验 · 每日 6 / 13 / 20 点（北京时）更新</div>
    {% endif %}
    <h1>天气预报准确度检验</h1>
    <p class="subtitle">把多家天气预报与气象站实况逐小时对账，用数据回答一个问题——<b>谁家的预报更准？</b></p>
    <div class="chips">
      <span class="chip">📅 评估窗口：{{ report.meta.start[:10] }} ~ {{ report.meta.end[:10] }}</span>
      <span class="chip">🔄 数据截至 {{ report.meta.end }}</span>
      <span class="chip">📍 {{ report.meta.stations|length }} 个观测站</span>
      <span class="chip">🛰️ {{ report.meta.models|length }} 家预报源</span>
      <span class="chip">🧮 综合分：温度 7 项 + 降水 6 项加权</span>
      <span class="chip">✅ 实况覆盖率 {{ '—' if report.coverage.coverage_pct is none else '%.0f%%'|format(report.coverage.coverage_pct) }}</span>
    </div>
    {% if champ %}
    <!-- 全页唯一的"一句话结论"：小白只看这一句也够 -->
    <div class="champion">🏆 {{ report.meta.period_label }} 月{% if not report.meta.is_monthly %}至今{% endif %}提前 1 天综合表现最好的是
      <b>{{ model_labels.get(champ.model, champ.model) }}</b>
      <div class="sub">综合得分 {{ num(champ.score, 1) }}（温度 {{ num(champ.temp_score, 1) }} 分 + 降水 {{ num(champ.precip_score, 1) }} 分）·
        温度准确率 {{ pct(champ.acc2) }}（误差 ≤2°C 即算准）· 晴雨评分 TS {{ num(champ.ts, 2) }}（0~1，越高越好）。
        更长提前量下谁守得住？见下方<a href="#leaderboard" style="color:#dbeafe">🏅 排行榜（可切提前天数）</a>与<a href="#score-trend" style="color:#dbeafe">📉 得分衰减曲线</a>。</div>
    </div>
    {% else %}
    <div class="champion">🌱 数据积累中——样本攒够后，这里会显示本月的"预报冠军"。</div>
    {% endif %}
  </div>
</header>

<div class="wrap">

  <!-- ==================== 新手引导：30 秒看懂 ==================== -->
  <section class="card">
    <h2>🌱 30 秒看懂本报告</h2>
    <p class="desc">只需记住 5 个概念，遇到别的术语可直达页面底部 <a href="#glossary">📖 名词小词典</a>。</p>
    <div class="guide-grid">
      <div class="guide-item"><div class="t">⏱️ 时效 = 提前量</div>
        <div class="d">预报是<b>提前多久</b>做的。排行榜每个「提前 N 天」一张榜——提前 1 天大家都准，提前 10 天谁守得住，切着看才知道。</div></div>
      <div class="guide-item"><div class="t">🏅 综合得分</div>
        <div class="d"><b>温度分</b>（7 项指标加权）与<b>降水分</b>（6 项指标加权）各算一个 0~100 的分，再取平均。一项"瘸腿"拿不了高分，构成明细见排行榜下方。</div></div>
      <div class="guide-item"><div class="t">🌡️ 温度准确率（±2°C）</div>
        <div class="d">预报温度与实况相差 <b>不超过 2°C</b> 就算报准。比例<b>越高越好</b>，100% = 满分。</div></div>
      <div class="guide-item"><div class="t">📉 温度误差（RMSE）</div>
        <div class="d">温度平均<b>报错了多少 °C</b>，<b>越小越好</b>，0 = 完美。它对"偶尔离谱的大误差"更敏感。</div></div>
      <div class="guide-item"><div class="t">🌧️ 晴雨评分（TS）</div>
        <div class="d">"下没下雨"报对程度的综合分（0~1），同时惩罚漏报和瞎报，<b>越高越好</b>。</div></div>
    </div>
  </section>

  <!-- ==================== 排行榜（表格式主视图）：每个提前量档一张榜 ==================== -->
  <section class="card" id="leaderboard">
    <h2>🏅 预报源排行榜</h2>
    <p class="desc">每个「提前量档」一张榜：先用按钮选好看<b>提前几天的预报</b>，榜单即按该时效下各源的综合得分排座次。
      点<b>任意列名</b>可改排序（如按 RMSE 找误差最小、按 TS 找晴雨最准）；数字全部来自与趋势图同一套加权公式。
      名次列始终是综合名次（👑 = 当前时效第一）；右侧走势线是该源得分随提前量 1~{{ (report.leaderboards or {})|length }} 天的衰减全程。
      样本不足的源沉底显示 —。</p>
    <div class="lb-controls">
      <div class="lb-buckets" id="lbBuckets" aria-label="选择提前天数"></div>
      <input type="search" id="lbSearch" class="lb-search" placeholder="🔍 搜索预报源…" aria-label="搜索预报源">
    </div>
    <noscript><p class="desc">榜单表格需要启用 JavaScript 渲染；无 JS 时本页仍提供顶部冠军结论与下方完整的"评分构成"权重表。</p></noscript>
    <div class="lb-scroll" id="lbScroll">
      <table class="lb-table" id="lbTable">
        <thead><tr id="lbHead"></tr></thead>
        <tbody id="lbBody"></tbody>
      </table>
    </div>
    <div id="lbEmpty" class="chart-empty" hidden>该时效暂无足够样本（数据积累中）——各源都在持续积累，通常再过几天这一档就会出现榜单。</div>
    <p class="hint">💡 <b>怎么看：</b>① 先看<b>综合分</b>列的名次与梯队（底纹条越长分越高）；② 切「提前 N 天」考验谁衰减得慢——
      提前 1 天的冠军不一定守得住第 10 天；③ 点列名按单一指标排队，<b>RMSE 等误差类越低越好，其余越高越好</b>；④ 走势线向右下掉是自然规律，
      <b>谁掉得慢、谁在右边还站得高</b>，谁的长效预报就更可靠。</p>
    <details class="lb-weights">
      <summary>🧮 综合分怎么算：13 项指标的加权构成（点开看明细）</summary>
      <div class="lb-weights-body">
        <div class="lb-weights-grid">
          <div>
            <h4>🌡️ 温度分（7 项，权重和 100%）</h4>
            <table>
              <thead><tr><th class="l">指标</th><th>权重</th><th class="l">0~100 换算</th></tr></thead>
              <tbody>
                {% for p in score_temp_parts %}
                <tr><td class="l">{{ p.label }}</td><td class="num">{{ p.pct }}%</td><td class="l">{{ p.map }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
            <p class="lb-why">不入分：RSS、χ²——χ²=RMSE²、RSS=n×χ²，是样本量的函数而非预报技巧（数值仍可在进阶区明细表查看）。</p>
          </div>
          <div>
            <h4>🌧️ 降水分（6 项，权重和 100%）</h4>
            <table>
              <thead><tr><th class="l">指标</th><th>权重</th><th class="l">0~100 换算</th></tr></thead>
              <tbody>
                {% for p in score_precip_parts %}
                <tr><td class="l">{{ p.label }}</td><td class="num">{{ p.pct }}%</td><td class="l">{{ p.map }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
            <p class="lb-why">不入分：漏报率（=100−命中率）、空报频率（与空报率同族仅分母不同）、
              雨量 RMSE/MAE/MBE（由个别强降水时段主导、随样本期气候波动大，跨源比较不公平）。</p>
          </div>
        </div>
        <p class="lb-why">各子分都截断到 0~100；某项缺数据时按<b>剩余权重</b>折算（"存疑不计亏"口径：缺数据≠差数据，
          不让单一缺项把整行踢出局，也不因缺项额外扣分）——缺失的维度在榜单里以 — 显示，读者可自行判断。
          综合分 = 温度分与降水分各占一半。把"报得准、误差小、节奏对、不偏科、雨报得实"分别记账再合并，比只用一两个指标更能区分真实水平。</p>
      </div>
    </details>
  </section>

  <!-- ==================== 得分随时效衰减（排行榜的趋势版） ==================== -->
  <section class="card" id="score-trend">
    <h2>📉 得分随时效衰减：谁"掉秤"掉得慢？</h2>
    <p class="desc">上面的榜单每次只看一个提前量档，这一节把<b>每一档提前量（第 1~16 天）的得分</b>连成曲线，
      一张图看清全部走势。同一套打分公式（综合 = 温度分 + 降水分），切换下方维度：</p>
    <div class="chart-controls">
      <div class="seg" id="scoreTrendTab">
        <button class="on" data-key="overall">综合得分</button>
        <button data-key="temp">温度得分</button>
        <button data-key="precip">降水得分</button>
      </div>
      <div class="cmp-mount" data-cmp></div>
    </div>
    <div id="chartScoreTrend" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b><b>灰带</b> = 全体预报源在各档时效的得分范围（虚线 = 全体中位），
      <b>彩色粗线</b> = 你聚焦的源（线尾直接标着名字）。所有线都会往右掉（提前量越大、预报越难），
      <b>谁掉得慢、谁在右边还站得高</b>，谁的中长期预报就更可靠。点图中的灰线可把它加入对比，
      或用"🎯 对比源"按钮任选几家。某条线中途断掉 = 该时效"样本不足"（还没有那么多天的数据，攒着攒着就有了）。</p>
  </section>

  <!-- ==================== 分区一：气温 ==================== -->
  <section class="card">
    <h2>🌡️ 气温预报准不准？</h2>
    <p class="desc">横轴是"预报提前量"（往右 = 预报更久以后的天气）。灰带是全体 {{ report.meta.models|length }} 家的范围，
      彩色粗线是你聚焦的源（线尾直标名字）。右侧指标下拉可切换温度的全部指标。</p>
    <div class="chart-controls">
      <label for="tempMetricSel">指标</label>
      <select id="tempMetricSel" aria-label="选择温度指标"></select>
      <div class="cmp-mount" data-cmp></div>
    </div>
    <div id="chartTempMetrics" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b>准确率/相关系数<b>越高越好</b>，RMSE/MAE/MBE <b>越低越好</b>。
      灰带 = 全体 {{ report.meta.models|length }} 家的范围，虚线 = 全体中位；彩色粗线 = 你聚焦的源，
      越贴着灰带下沿（误差类）或上沿（准确率类）越强。默认聚焦<b>排行榜前 3 名</b>——
      点图中的灰线可把任何一家加入对比，或用"🎯 对比源"按钮自选（最多 5 家）。</p>
  </section>

  <!-- ==================== 分区二：降水 ==================== -->
  <section class="card">
    <h2>🌧️ 下雨预报准不准？</h2>
    <p class="desc">把"降水量 ≥ {{ report.meta.rain_threshold_mm }}mm"记为"有雨"。指标下拉可切换降水的全部指标
      （晴雨评分族 + 降水量误差族）。分级降水（小/中/大/暴雨）见页面下方"进阶数据"。</p>
    <div class="chart-controls">
      <label for="precipMetricSel">指标</label>
      <select id="precipMetricSel" aria-label="选择降水指标"></select>
      <div class="cmp-mount" data-cmp></div>
    </div>
    <div id="chartPrecipMetrics" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b>TS / ETS / 准确率 / 命中率<b>越高越好</b>；空报率、漏报率<b>越低越好</b>；
      频率偏差 BIAS 越接近 1 越好（&gt;1 = 爱报雨，&lt;1 = 不爱报雨）。
      降水比温度难报得多——TS 到 0.3~0.5 已属正常水平，各家普遍不高不是报错了，而是下雨本身就难预测。</p>
  </section>

  <!-- ==================== 分区三：预报 vs 实况 ==================== -->
  <section class="card">
    <h2>🔍 亲眼对比：预报 vs 实况（最近 72 小时）</h2>
    <p class="desc">不看指标，直接用眼睛检验：黑线是气象站实测气温，彩线是预报（取每个时刻当时已发布的最新一版），蓝柱是预报降水量（右轴）。</p>
    <div class="chart-controls">
      <label for="tsStation">站点</label><select id="tsStation" aria-label="选择站点"></select>
      <label for="tsModel">预报源</label><select id="tsModel" aria-label="选择预报源"></select>
    </div>
    <div id="chartTs" class="chart tall"></div>
    <p class="hint">💡 <b>怎么看：</b>彩线越贴近黑线越准。可以切换不同站点和预报源，
      看看谁家能跟上气温的起伏节奏（尤其是每天最高/最低点的位置和幅度）。</p>
  </section>

  <!-- ==================== 分区四：逐日热力图 ==================== -->
  <section class="card">
    <h2>🗓️ 每日表现热力图</h2>
    <p class="desc">每个格子 = 某一天 × 某家预报源当天的温度准确率（±2°C）。行按排行榜名次排列（第一名在最上）。</p>
    <div id="chartHeat" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b><b>绿色</b> = 当天报得准，<b>红色</b> = 当天翻车，空白 = 数据不足。
      如果某天<b>整列发红</b>，说明那天所有预报源都没报准——往往是天气突变（如冷空气、突发降雨），不是某一家的锅；
      若某一行常年偏红，说明这一家整体拉胯。</p>
  </section>

  <!-- ==================== 分区五：分站对比 ==================== -->
  <section class="card">
    <h2>📍 各站点表现对比</h2>
    <p class="desc">同样是"提前 1 天"的预报，对比各家在不同气象站的表现。</p>
    <div class="chart-controls">
      <label for="stationMetricSel">指标</label>
      <select id="stationMetricSel" aria-label="选择分站指标"></select>
      <div class="cmp-mount" data-cmp></div>
    </div>
    <div id="chartStation" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b>同一预报源在不同站点表现可能有差异（地形、气候不同）。
      如果你只关心某个城市，找到对应的柱子比一比即可。</p>
  </section>

  <!-- ==================== 进阶数据（默认折叠，保持主页清爽） ==================== -->
  <details class="card" id="advanced">
    <summary>🧪 进阶数据：按天评估 · 分级降水 · 精细曲线 · 全指标明细表</summary>
    <div class="body">
      <h3>按天评估：日最高 / 最低气温准确率（日偏移 1~16 天）</h3>
      <p class="desc">把一天浓缩成两个数（最高/最低温），按"预报的是起报后第几天"分组。</p>
      <div class="chart-controls">
        <div class="cmp-mount" data-cmp></div>
      </div>
      <div id="chartTempDailyMax" class="chart"></div>
      <div id="chartTempDailyMin" class="chart"></div>

      <h3>按天评估：日降水指标（日偏移 1~16 天）</h3>
      <div class="chart-controls">
        <label for="precipDailySel">指标</label>
        <select id="precipDailySel" aria-label="选择按天降水指标"></select>
        <div class="cmp-mount" data-cmp></div>
      </div>
      <div id="chartPrecipDaily" class="chart"></div>

      <h3>分级降水分：日降水 TS（按 24 小时累计雨量分档）</h3>
      <p class="desc">不只看"下没下"，还看"下多大"：≥0.1mm（小雨以上）、≥10mm（中雨以上）、≥25mm（大雨以上）、
        ≥50mm（暴雨以上）、≥100mm（大暴雨以上）、≥250mm（特大暴雨以上）。</p>
      <div class="chart-controls">
        <label for="gradedOffsetSel">日偏移</label>
        <select id="gradedOffsetSel" aria-label="选择日偏移"></select>
        <div class="cmp-mount" data-cmp></div>
      </div>
      <div id="chartPrecipGraded" class="chart"></div>
      <p class="hint">💡 <b>怎么看：</b>雨越大越难报对，所以各档 TS 逐级走低是正常规律；
        某家在"大雨以上"还能保持高分，说明它对强降雨更有判断力。空缺 = 该档样本不足。</p>

      <h3>温度误差精细曲线（提前 1~72 小时，逐小时）</h3>
      <p class="desc">比天桶更细的颗粒度，用来观察前三天的误差衰减。</p>
      <div class="chart-controls">
        <label for="leadMetricSel">指标</label>
        <select id="leadMetricSel" aria-label="选择精细曲线指标"></select>
        <div class="cmp-mount" data-cmp></div>
      </div>
      <div id="chartTempLead" class="chart"></div>

      <h3>明细表 ①：逐小时口径全指标（按提前量选一天）</h3>
      <p class="desc">cyeva 温度 9 项 + 降水 16 项（晴雨 8 项 / 雨量误差 3 项 / 1h 雨强分级 TS 5 档）。
        n温 / n降 = 温度 / 降水列各自的有效样本对数（两者可能不同：降水缺测通常更多）；某一口径 n &lt;
        {{ report.meta.min_sample }} 时该组指标视为样本不足，显示 —。
        表格可左右滚动，模型列固定在左侧。</p>
      <div class="chart-controls">
        <label for="hourlyBucketSel">时效</label>
        <select id="hourlyBucketSel" aria-label="选择时效"></select>
      </div>
      <div id="detailTableHourly" style="overflow-x:auto"></div>

      <h3>明细表 ②：按天口径全指标（按日偏移选一天）</h3>
      <p class="desc">日最高/最低气温全套指标 + 日降水全套指标（含 24h 累计分档 TS）。</p>
      <div class="chart-controls">
        <label for="dailyOffsetSel">日偏移</label>
        <select id="dailyOffsetSel" aria-label="选择日偏移"></select>
      </div>
      <div id="detailTableDaily" style="overflow-x:auto"></div>
    </div>
  </details>

  <!-- ==================== 名词小词典 ==================== -->
  <section class="card" id="glossary">
    <h2>📖 名词小词典</h2>
    <p class="desc">页面里出现的术语，全部用大白话解释一遍。</p>
    <dl class="glossary">
      <div><dt>起报 / 起报快照</dt><dd>预报发布的那一刻叫"起报"。我们把每次起报的"未来 16 天逐小时预报"原样存档封存，等真实天气发生后再对账——预报不能事后改，检验才算数。</dd></div>
      <div><dt>时效（lead）</dt><dd>有效时刻 − 起报时刻，即"提前多久做的预报"。"3 天时效" = 提前 3 天报的。</dd></div>
      <div><dt>天桶</dt><dd>把时效按天分组：提前 1~24 小时算"第 1 天桶"，25~48 小时算"第 2 天桶"，以此类推。</dd></div>
      <div><dt>综合得分 / 温度分 / 降水分</dt><dd>把多个指标压缩成一个 0~100 的总分方便排名。温度分 = 7 项温度指标（±2°C/±1°C 准确率、RMSE/MAE 换算分、相关系数、偏差分、斜率分）按 25/25/15/10/10/10/5 加权；降水分 = 6 项降水指标（TS、ETS、晴雨准确率、命中率、空报率换算分、频率偏差分）按 30/25/15/15/10/5 加权；综合得分 = 两者均分。某项缺数据按剩余权重折算。点开排行榜的「评分构成」可看每个指标的换算公式。</dd></div>
      <div><dt>为什么有的指标不进综合分</dt><dd>χ²=RMSE²、RSS=样本量×χ²，是样本量的函数而非预报技巧；漏报率 = 100−命中率（纯重复）；空报频率与空报率同族（仅分母不同）；雨量 RMSE/MAE/MBE 由个别强降水时段主导、随当期气候波动大，跨源比较不公平——它们照常计算，只是不参与打分，可在进阶区明细表查看。</dd></div>
      <div><dt>提前量档与分时效排行榜</dt><dd>把时效按天分档（提前 1~24 小时 = 第 1 档…），每档一张排行榜。同一预报源在短时效可能领先、长时效掉队，切档对比才能看出谁"衰减得慢"。</dd></div>
      <div><dt>RMSE（均方根误差）</dt><dd>温度误差的"典型大小"，单位 °C，越小越好。比起 MAE，它对偶尔的大误差惩罚更重。</dd></div>
      <div><dt>MAE（平均绝对误差）</dt><dd>每次预报误差绝对值的平均，单位 °C，越小越好。最朴素的"平均差多少度"。</dd></div>
      <div><dt>MBE（平均偏差）</dt><dd>预报 − 实况的平均值。正数 = 习惯性报偏高，负数 = 报偏低，接近 0 最好。</dd></div>
      <div><dt>RSS（残差平方和）</dt><dd>所有样本误差的平方加总（°C²）。是 RMSE 的"未开方、未平均"版本，样本越多天然越大，只适合同一样本数的横向对比。</dd></div>
      <div><dt>χ²（卡方）</dt><dd>误差平方的平均（°C²），即 MSE。与 RMSE 的关系：RMSE = √χ²。越小越好。</dd></div>
      <div><dt>相关系数 r</dt><dd>预报与实况起伏的同步程度（−1~1）。越接近 1，预报越能跟上天气的"节奏"；接近 0 = 报了个寂寞。</dd></div>
      <div><dt>回归斜率</dt><dd>以预报为横轴、实况为纵轴做回归的斜率。&gt;1 = 预报的起伏幅度偏小（该热不热该冷不冷）；&lt;1 = 预报反应过激；=1 最理想。</dd></div>
      <div><dt>准确率（±1°C / ±2°C）</dt><dd>预报与实况相差不超过 1°C（或 2°C）的样本占比，越高越好。</dd></div>
      <div><dt>晴雨</dt><dd>把降水简化成是非题：降水量 ≥ {{ report.meta.rain_threshold_mm }}mm 算"有雨"，否则"无雨"。</dd></div>
      <div><dt>晴雨准确率</dt><dd>上述是非题"答对"的比例（报有雨确实下了 + 报没雨确实没下），越高越好。</dd></div>
      <div><dt>命中率（POD）</dt><dd>实际真的下雨的次数里，预报也报雨的比例。越高 = 漏报越少。</dd></div>
      <div><dt>空报率（FAR）</dt><dd>预报说会下雨的次数里，实际没下的比例。越低越好（"狼来了"次数）。</dd></div>
      <div><dt>空报频率（POFD）</dt><dd>实际没下雨的次数里，预报却报了雨的比例（与空报率分母不同）。越低越好。</dd></div>
      <div><dt>漏报率</dt><dd>实际下雨但预报没报出来的比例，越低越好。与命中率互补：漏报率 = 1 − POD。</dd></div>
      <div><dt>TS 评分</dt><dd>命中 ÷（命中 + 空报 + 漏报），0~1。降水检验最常用的综合分，同时奖励报中、惩罚误报。</dd></div>
      <div><dt>ETS 评分</dt><dd>对 TS 做"随机命中校正"的版本（0~1）。考虑"瞎蒙也能蒙对一部分"，ETS 更公平：瞎蒙的预报 ETS≈0，好预报才为正。</dd></div>
      <div><dt>频率偏差（BIAS）</dt><dd>报雨次数 ÷ 实际下雨次数。=1 频率正好；&gt;1 爱报雨；&lt;1 不爱报雨。</dd></div>
      <div><dt>雨量误差（RMSE / MAE / MBE）</dt><dd>不只看下没下，还看预报的降水量数值差多少（mm），越小越好。降水数值比晴雨难报得多。</dd></div>
      <div><dt>雨强分级（1h 口径）</dt><dd>按每小时雨量分档检验：小雨(0.1~1.9mm/h)、中雨(2~4.9)、大雨(5~9.9)、暴雨(10~19.9)、大暴雨(≥20)。每档可算全套晴雨类指标。</dd></div>
      <div><dt>累计分级（24h 口径）</dt><dd>按日累计雨量"达到某档以上"检验：≥0.1（小雨以上）、≥10（中雨以上）、≥25（大雨以上）、≥50（暴雨以上）、≥100（大暴雨以上）、≥250mm（特大暴雨以上）。</dd></div>
      <div><dt>样本数 n</dt><dd>参与指标计算的"预报-实况"对数。n &lt; {{ report.meta.min_sample }} 时本报告判"样本不足"，不下结论（显示 —）。</dd></div>
      <div><dt>观测覆盖率</dt><dd>评估窗口内成功抓到实况的小时占比。覆盖率低会让指标样本变少。</dd></div>
      <div><dt>月度归档</dt><dd>每月 1 号把上个月的结果冻结成一份永久档案（见下方归档区），之后不再变动。</dd></div>
    </dl>
  </section>

  <!-- ==================== 归档 + 生成机制 ==================== -->
  <section class="card">
    <h2>🗂️ 月度归档</h2>
    {% if archives %}
    <p class="desc">历史月份的冻结档案（每月 1 号自动归档上月），点开可看任意月份的完整结果：</p>
    <div class="archive-list">
      {% for a in archives %}<a href="{{ base }}monthly/{{ a }}.html">📦 {{ a }} 月报</a>{% endfor %}
    </div>
    {% else %}
    <p class="desc">暂无归档。每月 1 号（北京时）会自动把上个月冻结为一份永久档案，届时在这里列出。</p>
    {% endif %}

    <h2 style="margin-top:22px">⚙️ 本报告是怎么来的</h2>
    <ol class="steps">
      <li>每天 06:00 / 13:00 / 20:00（北京时）自动抓取 {{ report.meta.stations|length }} 个气象站的实况，以及各家预报源当时发布的起报数据。</li>
      <li>预报一旦发布立即原样封存，等真实天气发生后逐小时对账——先封存、后验证，杜绝"事后改预报"。</li>
      <li>本页指标每次都用当月积累的全部数据重新计算（评估计算由开源库 cyeva 完成：温度 9 项、降水晴雨 8 项 + 雨量误差 3 项 + 分级 11 档），所以打开永远是"本月至今"的最新结果。</li>
      <li>每月 1 号把上个月冻结成月度归档，永久可查。</li>
    </ol>
  </section>

</div>

<footer>
  生成时间：{{ generated_at }}（北京时）｜ 预报源：Open-Meteo（多模型）· 彩云天气 · 和风天气 · 中科天机 · 伏羲 · 风乌 · 中科星图 ｜
  实况：环境气象数据服务平台 eia-data.com<br>
  本页由 GitHub Actions 自动生成，每天 3 次更新；仅供学习参考，出行请以官方气象部门预报为准。
</footer>

<script>
/* ==========================================================================
 * 报告数据与绘图逻辑
 * 数据由 Python 端 evaluate.py 计算后以 JSON 内联；本脚本只负责"画出来"。
 * 每个图表块都套 try/catch：任何一张图出错都不影响页面其余部分。
 *
 * 多源对比的统一解法（24 家预报源，一条线一个颜色必然糊成一团）：
 *   - 主视图 = 表格式排行榜（每个提前量档一张榜，行内附得分衰减走势线），
 *     折线图退居辅助；
 *   - 对比图 = 战场带（全体 min-max 灰带 + 中位虚线）
 *     + 聚焦线（读者自选 ≤5 家的彩色粗线，线尾直标名字，无图例）
 *     + 可选灰细线层（全体各家，hover 高亮、点击即聚焦）；
 *   - 聚焦状态全局共享：改一处（选源器/排行榜行按钮/点灰线），全页图表同步刷新；
 *   - 指标维度用下拉切换，一张图承载一个指标族。
 * ========================================================================== */
const report = {{ report_json | safe }};
const MODEL_LABEL = {{ model_labels_json | safe }};    // 模型 id → 中文名
const MODEL_COLOR = {{ model_colors_json | safe }};    // 模型 id → 固定配色
const STATION_LABEL = {{ station_labels_json | safe }}; // 站点 id → 中文名

const labelOf   = m => MODEL_LABEL[m] || m;
const stationOf = s => STATION_LABEL[s] || s;
const PALETTE = ["#2563eb","#f59e0b","#10b981","#8b5cf6","#ef4444","#0ea5e9"];
const colorOf = m => MODEL_COLOR[m] || PALETTE[report.meta.models.indexOf(m) % PALETTE.length] || "#64748b";

const fmt = (v, d=1) => (v===null||v===undefined) ? "—" : Number(v).toFixed(d);
const pct = v => (v===null||v===undefined) ? "—" : Number(v).toFixed(1)+"%";
// 时间轴标签压缩："2026-08-27T15:00" → "08/27 15时"，避免横轴文字挤爆
const fmtT = t => t.slice(5,10).replace("-","/") + " " + t.slice(11,13) + "时";

/* ---------------- 模型顺序与"聚焦对比"体系 ---------------- */
const LEADERBOARDS = report.leaderboards || {};
const BOARD1 = LEADERBOARDS["1d"] || [];   // 提前 1 天榜（与 24h 评分卡同一样本总体）
// 图表系列顺序 = 提前 1 天榜名次（无分的排后面）
const rankedModels = BOARD1.length ? BOARD1.map(r => r.model) : report.meta.models;
const scoredModels = BOARD1.filter(r => r.score !== null && r.score !== undefined)
                           .map(r => r.model);
const rankOf = m => rankedModels.indexOf(m) + 1;
// 选源器的家族分组数据（render.py 注入）
const MODEL_FAMILIES = {{ model_families_json | safe }};

/* 全局聚焦状态：所有对比图共享同一组源，默认聚焦排行榜前 3 名 */
const MAX_FOCUS = 5;
const focus = new Set(scoredModels.slice(0, 3));
let showPack = false;   // 灰细线层开关：显示全体非聚焦源
let cmpMsg = "";        // 选源器临时提示（如超出家数上限）
let cmpMsgTimer = null;

const cmpRegistry = []; // 全部对比图 cfg：{el, x, getVal, yName, opts, chart}

function refreshCompare(cfg) {
  if (cfg.chart) cfg.chart.setOption(
    compareOption(cfg.x, cfg.getVal, cfg.yName, cfg.opts || {}), {notMerge:true});
}
function refreshAllCompare() {
  cmpRegistry.forEach(refreshCompare);
  renderPickers();
  renderRankFocus();
}
function setFocus(list) {
  focus.clear();
  list.slice(0, MAX_FOCUS).forEach(m => focus.add(m));
  refreshAllCompare();
}
function toggleFocus(m) {
  if (focus.has(m)) focus.delete(m);
  else if (focus.size >= MAX_FOCUS) {
    cmpMsg = "最多同时对比 " + MAX_FOCUS + " 家，请先取消一家再试";
    renderPickers();
    clearTimeout(cmpMsgTimer);
    cmpMsgTimer = setTimeout(() => { cmpMsg = ""; renderPickers(); }, 2600);
    return;
  } else focus.add(m);
  refreshAllCompare();
}

/* 逐档统计"全体源"：min / max / 中位 / 有数据家数 —— 战场带与 tooltip 摘要的原料 */
function fieldStats(getVal, n) {
  const out = [];
  for (let i = 0; i < n; i++) {
    const vals = [];
    rankedModels.forEach(m => {
      const v = getVal(m, i);
      if (v !== null && v !== undefined && !isNaN(v)) vals.push({m: m, v: v});
    });
    if (!vals.length) { out.push(null); continue; }
    vals.sort((a, b) => a.v - b.v);
    const mid = Math.floor((vals.length - 1) / 2);
    const median = vals.length % 2 ? vals[mid].v : (vals[mid].v + vals[mid + 1].v) / 2;
    out.push({min: vals[0].v, max: vals[vals.length - 1].v, median: median,
              maxBy: vals[vals.length - 1].m, minBy: vals[0].m, n: vals.length});
  }
  return out;
}

/* 对比图 option：三层视觉各答一个问题 ——
   灰带看"全体"，彩色粗线看"个体"，灰细线/hover 看"任意一家" */
function compareOption(x, getVal, yName, opts) {
  opts = opts || {};
  const stats = fieldStats(getVal, x.length);
  const fmtV = opts.valueFmt || (v => fmt(v));
  const series = [
    // 战场带下沿（min，透明占位）+ 带体（max-min，浅灰）—— 堆叠面积画法
    {id:"band-min", type:"line", stack:"band", data:stats.map(s => s ? s.min : null),
     lineStyle:{width:0}, symbol:"none", silent:true, z:1, connectNulls:false, areaStyle:{opacity:0}},
    {id:"band-range", type:"line", stack:"band",
     data:stats.map(s => s ? +(s.max - s.min).toFixed(4) : null),
     lineStyle:{width:0}, symbol:"none", silent:true, z:1, connectNulls:false,
     areaStyle:{color:"rgba(100,116,139,.14)"}},
    // 全体中位虚线
    {id:"field-median", type:"line", data:stats.map(s => s ? +s.median.toFixed(4) : null),
     smooth:true, symbol:"none", z:3, connectNulls:false,
     itemStyle:{color:"#94a3b8"}, lineStyle:{width:1.4, type:"dashed", color:"#94a3b8"}}
  ];
  if (showPack) {   // 灰细线层：其余各家；hover 高亮本色，点击即聚焦
    rankedModels.forEach(m => {
      if (focus.has(m)) return;
      series.push({id:"pack-" + m, name:labelOf(m), type:"line", smooth:true,
        connectNulls:false, z:2, symbol:"none", triggerLineEvent:true,
        data:x.map((_, i) => getVal(m, i)),
        itemStyle:{color:colorOf(m)}, lineStyle:{width:1, color:"rgba(100,116,139,.32)"},
        emphasis:{itemStyle:{color:colorOf(m)}, lineStyle:{width:2.2, color:colorOf(m)}}});
    });
  }
  rankedModels.forEach(m => {   // 聚焦粗线：线尾直标名字，彻底取代图例
    if (!focus.has(m)) return;
    series.push({id:"focus-" + m, name:labelOf(m), type:"line", smooth:true,
      connectNulls:false, z:4, showSymbol:false, triggerLineEvent:true,
      data:x.map((_, i) => getVal(m, i)),
      itemStyle:{color:colorOf(m)}, lineStyle:{width:2.4, color:colorOf(m)},
      endLabel:{show:true, formatter:labelOf(m), color:colorOf(m), fontSize:11,
                fontWeight:600, backgroundColor:"rgba(255,255,255,.9)",
                padding:[2, 5], borderRadius:4, distance:5,
                // 统一上浮：线在 0 值处结束时（如 TS 归零）避免压到 x 轴刻度文字
                offset:[0, -12]},
      labelLayout:{moveOverlap:"shiftY"}, emphasis:{focus:"series"}});
  });
  return {
    animationDuration:150,
    tooltip:{trigger:"axis", confine:true, axisPointer:{type:"line"},
      formatter: params => {
        const i = params && params.length ? params[0].dataIndex : 0;
        const rows = [];
        rankedModels.forEach(m => {
          if (!focus.has(m)) return;
          rows.push('<span style="display:inline-block;width:9px;height:9px;border-radius:50%;' +
            'background:' + colorOf(m) + ';margin-right:6px"></span>' + labelOf(m) +
            '　<b style="font-variant-numeric:tabular-nums">' + fmtV(getVal(m, i)) + "</b>");
        });
        const s = stats[i];
        if (s) rows.push('<span style="color:#64748b">战场 ' + s.n + " 家：最高 " + fmtV(s.max) +
          "（" + labelOf(s.maxBy) + "）· 中位 " + fmtV(s.median) + " · 最低 " + fmtV(s.min) +
          "（" + labelOf(s.minBy) + "）</span>");
        return '<div style="font-weight:600;margin-bottom:2px">' + x[i] + "</div>" +
               rows.join("<br>");
      }},
    // 右侧留白给线尾名字；未聚焦时收紧
    grid:{left:62, right:focus.size ? 104 : 30, top:26, bottom:44},
    xAxis:{type:"category", data:x, name:opts.xName || "",
           axisLabel:{rotate: x.length > 10 ? 30 : 0}},
    yAxis:{type:"value", name:yName, scale:!!opts.scale},
    series: series
  };
}

/* 对比图工厂：所有多源折线图的入口；cfg = {el, x, getVal, yName, opts} */
function compareLineChart(cfg) {
  const el = document.getElementById(cfg.el);
  if (!el || typeof echarts === "undefined") return null;
  const ch = echarts.init(el);
  charts.push(ch);
  cfg.chart = ch;
  ch.setOption(compareOption(cfg.x, cfg.getVal, cfg.yName, cfg.opts || {}), {notMerge:true});
  // 点灰线 = 把这一家加入聚焦（看到哪条有意思，点它就行）。
  // 注意：线体事件（triggerLineEvent）的参数只有 seriesName/seriesIndex，没有 seriesId，
  // 故用中文名反查模型 id；聚焦线再点不动作（取消聚焦只走选源器/排行卡，避免误删）。
  ch.on("click", p => {
    if (!p || p.componentType !== "series" || !p.seriesName) return;
    const m = rankedModels.find(k => labelOf(k) === p.seriesName);
    if (m && !focus.has(m)) toggleFocus(m);
  });
  cmpRegistry.push(cfg);
  return ch;
}

/* ---------------- 选源器：家族分组 + 搜索 + 预设（多挂载点共享同一状态） ---------------- */
function renderPickers() {
  document.querySelectorAll("[data-cmp]").forEach(renderPickerMount);
}
function renderPickerMount(mount) {
  const open = mount.dataset.open === "1";
  const n = focus.size;
  let html = '<button type="button" class="cmp-btn' + (n ? "" : " none") +
    '" aria-expanded="' + open + '">🎯 对比源 <b>' + n + "</b>" + (n ? "" : "（未选）") + "</button>" +
    '<label class="cmp-pack"><input type="checkbox"' + (showPack ? " checked" : "") +
    "> 显示各家曲线</label>";
  if (open) {
    const q = mount._q || "";
    const ql = q.trim().toLowerCase();
    let body = '<div class="cmp-presets">' +
      '<button type="button" data-preset="champ">🥇 只看冠军</button>' +
      '<button type="button" data-preset="top3">前 3 名</button>' +
      '<button type="button" data-preset="clear">清空</button>' +
      '<input type="search" class="cmp-search" placeholder="搜源名…" value="' +
      String(q).replace(/[&<>"']/g,
        c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])) + '"></div>';
    MODEL_FAMILIES.forEach(fam => {
      const ms = (fam.models || [])
        .filter(m => rankedModels.indexOf(m) !== -1)
        .filter(m => !ql || labelOf(m).toLowerCase().indexOf(ql) !== -1 ||
                      m.toLowerCase().indexOf(ql) !== -1)
        .sort((a, b) => rankOf(a) - rankOf(b));
      if (!ms.length) return;
      body += '<div class="cmp-fam"><div class="cmp-fam-name">' + (fam.icon || "") + " " +
        fam.name + '</div><div class="cmp-chips">';
      ms.forEach(m => {
        body += '<button type="button" class="cmp-chip' + (focus.has(m) ? " on" : "") +
          '" data-model="' + m + '"><span class="dot" style="background:' + colorOf(m) +
          '"></span>' + labelOf(m) + "<i>#" + rankOf(m) + "</i></button>";
      });
      body += "</div></div>";
    });
    body += '<div class="cmp-msg">' +
      (cmpMsg || ("最多同时对比 " + MAX_FOCUS + " 家；点图中的灰线也可加入对比")) + "</div>";
    html += '<div class="cmp-panel">' + body + "</div>";
  }
  mount.innerHTML = html;
  mount.querySelector(".cmp-btn").addEventListener("click", () => {
    mount.dataset.open = open ? "0" : "1";
    renderPickerMount(mount);
  });
  mount.querySelector(".cmp-pack input").addEventListener("change", e => {
    showPack = e.target.checked;
    refreshAllCompare();
  });
  if (open) {
    mount.querySelectorAll("[data-preset]").forEach(b => b.addEventListener("click", () => {
      if (b.dataset.preset === "champ") setFocus(scoredModels.slice(0, 1));
      else if (b.dataset.preset === "top3") setFocus(scoredModels.slice(0, 3));
      else setFocus([]);
    }));
    const search = mount.querySelector(".cmp-search");
    search.addEventListener("input", () => {
      mount._q = search.value;
      mount._refocus = true;
      renderPickerMount(mount);
    });
    mount.querySelectorAll(".cmp-chip").forEach(c =>
      c.addEventListener("click", () => toggleFocus(c.dataset.model)));
  }
  if (mount._refocus) {   // 搜索输入触发的重渲染：把焦点还给输入框（光标移到末尾）
    mount._refocus = false;
    const inp = mount.querySelector(".cmp-search");
    if (inp) { inp.focus(); const L = inp.value.length; inp.setSelectionRange(L, L); }
  }
}

/* ---------------- 排行榜行内聚焦按钮状态 ---------------- */
function renderRankFocus() {
  document.querySelectorAll("[data-focus-model]").forEach(btn => {
    const on = focus.has(btn.dataset.focusModel);
    btn.classList.toggle("on", on);
    btn.textContent = on ? "✓ 已聚焦" : "👁 聚焦";
  });
}
/* 行内聚焦按钮的点击用事件委托挂 document：排行榜 tbody 会被整体重建，
 * 若在脚本加载时逐个绑定，新渲染出的按钮全部没有监听器（死控件） */
document.addEventListener("click", e => {
  const btn = e.target && e.target.closest ? e.target.closest("[data-focus-model]") : null;
  if (btn) toggleFocus(btn.dataset.focusModel);
});

/* ---------------- 排行榜主视图：切提前天数 / 列排序 / 搜索 / 名次走势 ----------------
 * 数据全部来自服务端的 report.leaderboards（每个天桶一份按综合分排好序的行），
 * 前端只做重排/过滤/渲染，不在浏览器里重算分数——保证榜单、趋势图、冠军横幅同源。 */
let renderLeaderboard = null;   // 供聚焦刷新后的按钮态重绘使用
try {
  const BUCKETS = Object.keys(LEADERBOARDS).sort((a, b) => parseInt(a, 10) - parseInt(b, 10));
  const TREND_OV = (report.score_trend || {}).overall || {};
  const FAMILY_ICON = {};
  MODEL_FAMILIES.forEach(f => (f.models || []).forEach(m => { FAMILY_ICON[m] = f.icon || ""; }));

  // 榜面数值列（名次/源名/走势/操作为固定列，不参与排序）
  const LB_COLS = [
    {key:"score",        label:"综合分",  dir:"desc", dec:1, primary:true},
    {key:"temp_score",   label:"温度分",  dir:"desc", dec:1},
    {key:"precip_score", label:"降水分",  dir:"desc", dec:1},
    {key:"acc2",         label:"±2°C",    dir:"desc", dec:1, unit:"%", title:"温度 ±2°C 命中率，越高越好"},
    {key:"rmse",         label:"RMSE °C", dir:"asc",  dec:2, title:"温度均方根误差，越低越好"},
    {key:"ts",           label:"晴雨 TS", dir:"desc", dec:2, title:"晴雨评分 0~1，越高越好"},
    {key:"ets",          label:"晴雨 ETS",dir:"desc", dec:2, title:"校正后 TS 0~1，越高越好"},
  ];
  let bucket = BUCKETS.find(b => (LEADERBOARDS[b] || []).some(r => r.score !== null)) || BUCKETS[0];
  let sortKey = "score", sortDir = "desc", lbQuery = "";

  // 名次只跟综合分绑定：无论当前按哪列排序，名次列始终显示该源在本时效的综合名次
  function lbRankMap(rows) {
    const map = {};
    rows.filter(r => r.score !== null && r.score !== undefined)
        .sort((a, b) => b.score - a.score)
        .forEach((r, i) => { map[r.model] = i + 1; });
    return map;
  }

  /* 行内走势线：全局 y 域（所有源所有档）横向可比，中位参考线才有意义 */
  const sparkDomain = (() => {
    let lo = Infinity, hi = -Infinity;
    const byModel = {};
    rankedModels.forEach(m => {
      const vals = BUCKETS.map(b => {
        const v = (TREND_OV[m] || {})[b];
        return (v === null || v === undefined) ? null : v;
      });
      byModel[m] = vals;
      vals.forEach(v => { if (v !== null) { lo = Math.min(lo, v); hi = Math.max(hi, v); } });
    });
    if (lo === Infinity) return null;
    const med = BUCKETS.map((_, i) => {
      const vs = rankedModels.map(m => byModel[m][i]).filter(v => v !== null).sort((a, b) => a - b);
      if (!vs.length) return null;
      const mid = Math.floor((vs.length - 1) / 2);
      return vs.length % 2 ? vs[mid] : (vs[mid] + vs[mid + 1]) / 2;
    });
    return {lo, hi, byModel, med};
  })();

  function sparkSVG(vals, lo, hi, color, markIdx) {
    const W = 110, H = 32, P = 3, span = Math.max(1, vals.length - 1);
    const px = i => P + i * (W - 2 * P) / span;
    const py = v => H - P - (v - lo) / (hi - lo || 1) * (H - 2 * P);
    const path = vs => {
      let d = "", pen = false;
      vs.forEach((v, i) => {
        if (v === null || v === undefined) { pen = false; return; }
        d += (pen ? " L" : " M") + px(i).toFixed(1) + " " + py(v).toFixed(1);
        pen = true;
      });
      return d;
    };
    let dot = "";
    if (markIdx >= 0 && vals[markIdx] !== null && vals[markIdx] !== undefined)
      dot = '<circle cx="' + px(markIdx).toFixed(1) + '" cy="' + py(vals[markIdx]).toFixed(1) +
            '" r="3" fill="' + color + '" stroke="#fff" stroke-width="1.2"/>';
    return '<svg viewBox="0 0 ' + W + " " + H + '" preserveAspectRatio="none" aria-hidden="true">' +
      '<path d="' + path(sparkDomain.med) + '" fill="none" stroke="#cbd5e1" stroke-width="1" ' +
      'stroke-dasharray="3 2" vector-effect="non-scaling-stroke"/>' +
      '<path d="' + path(vals) + '" fill="none" stroke="' + color + '" stroke-width="1.8" ' +
      'stroke-linejoin="round" vector-effect="non-scaling-stroke"/>' + dot + "</svg>";
  }

  function renderBucketPills() {
    const el = document.getElementById("lbBuckets");
    if (!el) return;
    el.innerHTML = BUCKETS.map(b => {
      const cnt = (LEADERBOARDS[b] || []).filter(r => r.score !== null).length;
      return '<button type="button" class="lb-pill' + (b === bucket ? " on" : "") +
        (cnt ? "" : " empty") + '" data-bucket="' + b + '" aria-pressed="' + (b === bucket) +
        '" title="提前 ' + parseInt(b, 10) + ' 天预报的排行榜' + (cnt ? "" : "（暂无足够样本）") + '">提前' +
        parseInt(b, 10) + "天" + (cnt ? "<i>" + cnt + "</i>" : "") + "</button>";
    }).join("");
    el.querySelectorAll("[data-bucket]").forEach(btn =>
      btn.addEventListener("click", () => { bucket = btn.dataset.bucket; renderLeaderboard(); }));
  }

  function lbHeadHtml() {
    const fixed = [{key:"_rank", label:"#", cls:"c-rank"}, {key:"_name", label:"预报源", cls:"c-name l"}];
    const tail = [{key:"_spark", label:"得分走势", cls:""}, {key:"_act", label:"", cls:"c-act"}];
    const cols = fixed.concat(LB_COLS.map(c => ({key:c.key, label:c.label, cls:"num", title:c.title})), tail);
    return cols.map(c => {
      const active = c.key === sortKey;
      const ind = active ? '<span class="ind">' + (sortDir === "desc" ? "▼" : "▲") + "</span>" : "";
      const aria = active ? ' aria-sort="' + (sortDir === "desc" ? "descending" : "ascending") + '"' : "";
      const tip = c.title ? ' title="' + c.title + '"' : "";
      return '<th scope="col" class="' + c.cls + (c.key === sortKey ? " on" : "") + '"' +
        (LB_COLS.some(x => x.key === c.key) ? ' data-key="' + c.key + '"' : "") + aria + tip + ">" +
        c.label + ind + "</th>";
    }).join("");
  }

  function lbRowHtml(row, rank, markIdx) {
    const m = row.model;
    const none = row.score === null || row.score === undefined;
    const fmtC = (v, dec, unit) =>
      (v === null || v === undefined) ? "—" : Number(v).toFixed(dec) + (unit || "");
    const barStyle = none ? "" : ' style="--w:' + Math.max(0, Math.min(100, row.score)).toFixed(1) + '%"';
    const rankCell = (rank === 1 && !none) ? "🥇" : (rank === 2 && !none) ? "🥈" :
                     (rank === 3 && !none) ? "🥉" : (rank || "·");
    const spark = sparkDomain
      ? sparkSVG(sparkDomain.byModel[m] || [], sparkDomain.lo, sparkDomain.hi, colorOf(m), markIdx)
      : "";
    const crown = (rank === 1 && !none) ? "👑 " : "";
    return '<tr class="' + (rank === 1 && !none ? "lb-first" : "") + (none ? " lb-none" : "") + '">' +
      '<td class="c-rank lb-rank">' + rankCell + "</td>" +
      '<td class="c-name l">' + crown + '<span class="dot" style="background:' + colorOf(m) +
        '"></span><span class="fam">' + (FAMILY_ICON[m] || "") + "</span><b>" + labelOf(m) +
        '</b><span class="id">' + m + "</span></td>" +
      '<td class="num lb-pri"' + barStyle + ">" +
        (none ? '<span class="na">样本积累中</span>' : fmtC(row.score, 1)) + "</td>" +
      "<td class=\"num\">" + fmtC(row.temp_score, 1) + "</td>" +
      "<td class=\"num\">" + fmtC(row.precip_score, 1) + "</td>" +
      "<td class=\"num\">" + fmtC(row.acc2, 1, "%") + "</td>" +
      "<td class=\"num\">" + fmtC(row.rmse, 2) + "</td>" +
      "<td class=\"num\">" + fmtC(row.ts, 2) + "</td>" +
      "<td class=\"num\">" + fmtC(row.ets, 2) + "</td>" +
      '<td class="c-spark">' + spark + "</td>" +
      '<td class="num lb-n" title="有效样本对：温度/降水">' + (row.n || 0) + "/" + (row.n_precip || 0) + "</td>" +
      '<td class="c-act"><button type="button" class="rank-focus" data-focus-model="' + m +
        '" title="在下方所有对比图中聚焦/取消这一家">👁 聚焦</button></td></tr>';
  }

  renderLeaderboard = function () {
    const head = document.getElementById("lbHead");
    const body = document.getElementById("lbBody");
    const scroll = document.getElementById("lbScroll");
    const empty = document.getElementById("lbEmpty");
    if (!head || !body) return;
    renderBucketPills();
    head.innerHTML = lbHeadHtml();
    const rows = (LEADERBOARDS[bucket] || []).slice();
    const hasScore = rows.some(r => r.score !== null);
    if (!hasScore) {          // 该时效整体样本不足：空态提示而非空表
      scroll.hidden = true;
      empty.hidden = false;
      body.innerHTML = "";
      return;
    }
    scroll.hidden = false;
    empty.hidden = true;
    const dirMul = sortDir === "asc" ? 1 : -1;
    rows.sort((a, b) => {
      const va = a[sortKey], vb = b[sortKey];
      const an = va === null || va === undefined, bn = vb === null || vb === undefined;
      if (an && bn) return 0;
      if (an) return 1;        // 缺项恒沉底（与方向无关）
      if (bn) return -1;
      return (va - vb) * dirMul;
    });
    const q = lbQuery.trim().toLowerCase();
    const shown = q ? rows.filter(r =>
      labelOf(r.model).toLowerCase().indexOf(q) !== -1 ||
      r.model.toLowerCase().indexOf(q) !== -1) : rows;
    const ranks = lbRankMap(rows);
    const markIdx = BUCKETS.indexOf(bucket);
    if (!shown.length) {      // 搜索无匹配：给出提示行而非无声空表
      const esc = s => s.replace(/[&<>"']/g,
        c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
      body.innerHTML = '<tr><td colspan="12" style="text-align:center;color:#94a3b8;padding:18px">' +
        '没有匹配「' + esc(lbQuery.trim()) + '」的预报源，清空搜索框可看完整榜单</td></tr>';
      return;
    }
    body.innerHTML = shown.map(r => lbRowHtml(r, ranks[r.model] || null, markIdx)).join("");
    renderRankFocus();
  };

  // 表头点击排序（事件委托挂在 thead 上，innerHTML 重建后依然有效）
  const lbHeadEl = document.getElementById("lbHead");
  if (lbHeadEl) lbHeadEl.addEventListener("click", e => {
    const th = e.target.closest("th[data-key]");
    if (!th) return;
    const col = LB_COLS.find(c => c.key === th.dataset.key);
    if (!col) return;
    if (sortKey === col.key) sortDir = sortDir === "desc" ? "asc" : "desc";
    else { sortKey = col.key; sortDir = col.dir; }
    renderLeaderboard();
  });
  const lbSearch = document.getElementById("lbSearch");
  // input 覆盖键入；search 兜住 type="search" 原生 ✕ 清空按钮（Chromium 上两者都会发）
  const onSearch = () => { lbQuery = lbSearch.value; renderLeaderboard(); };
  if (lbSearch) { lbSearch.addEventListener("input", onSearch); lbSearch.addEventListener("search", onSearch); }
  renderLeaderboard();
} catch(e) { console.error("leaderboard", e); }

/* ---------------- 图表基础设施 ---------------- */
const charts = [];
function makeChart(id, option) {
  const el = document.getElementById(id);
  if (!el || typeof echarts === "undefined") return null;
  const ch = echarts.init(el);
  ch.setOption(option);
  charts.push(ch);
  return ch;
}
window.addEventListener("resize", () => charts.forEach(c => c.resize()));

// 数据为空时把图容器换成提示文案（月初数据积累期常见）
function emptyNote(id, text) {
  const el = document.getElementById(id);
  if (el) { el.className = "chart-empty"; el.textContent = text; }
}

