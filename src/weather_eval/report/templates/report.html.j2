  {key:"bias",  label:"频率偏差 BIAS", axis:"BIAS(报雨/实雨)", scale:true,  dec:2},
  {key:"rmse",  label:"雨量 RMSE",     axis:"RMSE(mm)",        scale:true,  dec:2},
  {key:"mae",   label:"雨量 MAE",      axis:"MAE(mm)",         scale:true,  dec:2},
  {key:"mbe",   label:"雨量 MBE",      axis:"MBE(mm)",         scale:true,  dec:2},
];

// 填充一个 <select> 的选项
function fillSelect(selId, metrics, def) {
  const sel = document.getElementById(selId);
  if (!sel) return null;
  metrics.forEach(mt => {
    const o = document.createElement("option");
    o.value = mt.key; o.text = mt.label;
    sel.appendChild(o);
  });
  if (def) sel.value = def;
  return sel;
}

// 通用"指标下拉 + 对比图"：切换指标时更新 y 轴与数据（getVal 动态读取当前指标）
function metricLineChart(cfg) {
  // cfg: {el, selId, metrics, x, valueFn(m, i, key), def}
  const sel = fillSelect(cfg.selId, cfg.metrics, cfg.def);
  if (!sel) return;
  function metOf(k) { return cfg.metrics.find(x => x.key === k) || cfg.metrics[0]; }
  function optsOf(k) {
    const mt = metOf(k);
    return {scale: !!mt.scale, xName: cfg.xName,
            valueFmt: v => fmt(v, mt.dec === undefined ? 1 : mt.dec)};
  }
  const ccfg = {el: cfg.el, x: cfg.x,
    getVal: (m, i) => cfg.valueFn(m, i, sel.value),
    yName: metOf(sel.value).axis, opts: optsOf(sel.value)};
  compareLineChart(ccfg);
  sel.onchange = () => {
    ccfg.yName = metOf(sel.value).axis;
    ccfg.opts = optsOf(sel.value);
    refreshCompare(ccfg);
  };
}

/* ---------------- 得分随时效衰减（综合/温度/降水三个维度） ---------------- */
try {
  const buckets = Object.keys(report.score_trend.overall[rankedModels[0]] || {});
  const x = buckets.map(b => "提前" + b.replace("d","") + "天");
  const el = document.getElementById("chartScoreTrend");
  if (!buckets.length || !el) {
    emptyNote("chartScoreTrend", "数据积累中：得分趋势需要至少几个时效桶的样本");
  } else {
    let key = "overall";
    const cfg = {el:"chartScoreTrend", x,
      getVal:(m, i) => { const v = (report.score_trend[key][m] || {})[buckets[i]];
                         return (v === null || v === undefined) ? null : v; },
      yName:"综合得分(0~100)", opts:{scale:false, valueFmt:v => fmt(v, 1)}};
    const ch = compareLineChart(cfg);
    const tab = document.getElementById("scoreTrendTab");
    tab.querySelectorAll("button").forEach(btn => {
      btn.addEventListener("click", () => {
        if (!ch) return;   // echarts 加载失败时 compareLineChart 返回 null，切换不应抛错
        tab.querySelectorAll("button").forEach(b => b.classList.toggle("on", b === btn));
        key = btn.dataset.key;
        cfg.yName = key === "temp" ? "温度得分(0~100)" :
                    key === "precip" ? "降水得分(0~100)" : "综合得分(0~100)";
        refreshCompare(cfg);
      });
    });
  }
} catch(e) { console.error("scoreTrend", e); }

/* ---------------- 温度：全指标随时效（天桶） ---------------- */
try {
  const buckets = Object.keys(report.temp_hourly[rankedModels[0]] || {});
  const x = buckets.map(b => "提前" + b.replace("d","") + "天");
  if (!buckets.length) { emptyNote("chartTempMetrics", "数据积累中"); }
  else metricLineChart({el:"chartTempMetrics", selId:"tempMetricSel",
