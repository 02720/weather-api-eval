} catch(e) { console.error("tempMetrics", e); }

/* ---------------- 降水：全指标随时效（天桶） ---------------- */
try {
  const buckets = Object.keys(report.precip_hourly[rankedModels[0]] || {});
  const x = buckets.map(b => "提前" + b.replace("d","") + "天");
  if (!buckets.length) { emptyNote("chartPrecipMetrics", "数据积累中"); }
  else metricLineChart({el:"chartPrecipMetrics", selId:"precipMetricSel",
