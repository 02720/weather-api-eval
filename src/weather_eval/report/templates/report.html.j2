<!DOCTYPE html>
{# ============================================================================
  天气预报准确度检验报告（2026-09 第一性原理重构）

  页面只回答一个问题：**谁家预报最准？** 一切结构为它服务——
    答案（Hero 冠军卡）→ 证据（一张服务端渲染的总榜）→ 理解（五张各司其职的
    图）→ 深挖（折叠的方法论与词典）→ 归档（页脚）。

  与旧版（2026-08）的取舍：
  - 排行榜默认只在服务端渲染一张"总榜"（难度对齐综合分）。33 张分时效榜不再
    每张各渲染一张表，而是以「榜单切换下拉 + 预排序行数组」回归：默认视图仍是
    服务端渲染（无 JS 可读的硬约束不破），切到某个「提前 N 天」后由前端把
    服务端排好序的行填进同一张表（前端只搬运、不重算名次）。分时效的直接
    对照也可在 §02 衰减曲线上读。
  - 榜单表格、得分走势线（SVG）、Hero 实况曲线都在 Python 侧生成：无 JS 也能
    读到完整榜单，"前端异常 → 榜单静默消失"这类事故失去载体。
  - 内联 JSON 只含图表用字段（render._slim_report），页面从 1.9MB 降到数百 KB；
    新增的内联数据同样只画不打：分时效榜行数组、热力图降水矩阵、分站全指标。
  - 旧版选源器/分屏/聚焦状态机不再整台搬回：图表仍用 ECharts 原生图例承担
    "显隐"，但 28 个源挤在滚动图例里点选太费劲，故配一个**按源家族分组**的
    选源面板（复选框 + 前三名/全部/清空），与图例双向同步。

  文案遵循"小白能看懂"标准：每图一行"怎么看"，深入解释全部收进折叠区。
============================================================================ #}
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<!-- 手机端：地址栏/状态栏与 Hero 深蓝同色，页面不再是"白底深色头"的割裂感 -->
<meta name="theme-color" content="#0c2340">
<meta name="color-scheme" content="light">
<meta name="description" content="自动把 20 多家天气预报与气象站实况逐小时对账，用数据回答：谁家预报更准？每天自动更新。">
<title>{{ title }}</title>
<!-- ECharts 使用仓库内本地副本（避免 CDN 不可达）。加载失败时图表区会显示
     兜底提示，服务端渲染的榜单与结论不受影响。 -->
<script src="{{ base }}vendor/echarts.min.js"></script>
<style>
  /* ================= 设计变量：观测簿蓝墨水 × 公报衬线 ================= */
  :root {
    --paper:#f2f4f7; --card:#ffffff; --line:#dce3ec; --line-soft:#e8edf3;
    --ink:#0c2340; --ink-2:#14305a;
    --blue:#205fa7; --blue-deep:#15436f; --blue-soft:#eaf1f9;
    --gold:#b7791f; --gold-soft:#fbf3e2; --gold-line:#e6cf9a;
    --good:#2e8b57; --bad:#c0492f;
    --slate:#35455e; --muted:#68778f;
    --serif:"Noto Serif SC","Source Han Serif SC","Songti SC","STSong","SimSun",serif;
    --sans:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB",
           "Microsoft YaHei","Segoe UI",Roboto,sans-serif;
    --radius:14px;
    --shadow:0 1px 2px rgba(12,35,64,.05),0 6px 20px rgba(12,35,64,.06);
  }
  * { box-sizing:border-box; }
  html, body { overflow-x:clip; }
  [hidden] { display:none !important; }
  /* 移动端横竖屏切换时 iOS 会擅自放大字号，正文排版随之跳动——显式关掉 */
  html { scroll-behavior:smooth; -webkit-text-size-adjust:100%; text-size-adjust:100%; }
  /* 只在宽屏/只在手机出现的句子（对应不同的交互方式，见 §01 说明与 §04 提示） */
  .only-mobile { display:none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior:auto; }
    * { animation-duration:.01ms !important; transition-duration:.01ms !important; }
  }
  body { margin:0; background:var(--paper); color:var(--slate);
         font-family:var(--sans); font-size:15px; line-height:1.65; }
  h1,h2,h3 { color:var(--ink); font-family:var(--serif); line-height:1.3; }
  a { color:var(--blue); }
  .num { font-variant-numeric:tabular-nums; }

  /* ================= Hero：公报头版 ================= */
  .hero { position:relative; overflow:hidden; color:#eaf1fb;
          background:linear-gradient(160deg,#0c2340 0%,#122c50 58%,#1a3a63 100%); }
  /* 签名装饰：真实观测气温曲线横贯版面（服务端从第一站 72h 实况生成） */
  .hero-curve { position:absolute; left:0; right:0; bottom:-6px; height:190px;
                opacity:.8; pointer-events:none; }
  .hero-curve svg { width:100%; height:100%; display:block; }
  .hero-inner { position:relative; max-width:1120px; margin:0 auto; padding:46px 22px 56px; }
  .hero-badge { display:inline-flex; align-items:center; gap:8px;
                border:1px solid rgba(154,193,236,.35); background:rgba(154,193,236,.12);
                border-radius:999px; padding:4px 14px; font-size:12.5px; color:#cfe0f2;
                letter-spacing:.5px; }
  .hero h1 { margin:18px 0 8px; font-size:42px; font-weight:900; color:#f5f8fd;
             letter-spacing:2px; }
  .hero h1 .q { color:#f0c75e; }
  .hero .lede { margin:0 0 26px; font-size:15.5px; color:#b9cbe2; max-width:760px; }
  .lede b { color:#e8f0fb; }

  /* 冠军卡：版面唯一的主角 */
  .champ { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:26px;
           background:rgba(255,255,255,.055); border:1px solid rgba(154,193,236,.25);
           border-radius:18px; padding:24px 26px; backdrop-filter:blur(4px); }
  .champ-kicker { font-size:12.5px; letter-spacing:3px; color:#8fb4dd; margin-bottom:8px; }
  .champ-name { font-family:var(--serif); font-size:34px; font-weight:900; color:#fdfdfd;
                line-height:1.25; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .champ-name .warn-badge { font-size:12px; font-family:var(--sans); font-weight:600;
       color:#ffd9a0; border:1px solid rgba(255,217,160,.4); border-radius:99px;
       padding:1px 10px; cursor:help; }
  .champ-facts { display:flex; flex-wrap:wrap; gap:6px 22px; margin-top:14px;
                 font-size:13.5px; color:#c4d5ea; }
  .champ-facts b { color:#f2f7fd; font-variant-numeric:tabular-nums; }
  .champ-facts .lab { color:#8fb0d6; margin-right:5px; font-size:12px; }
  .champ-score-box { text-align:right; }
  .champ-score { font-family:var(--serif); font-size:58px; font-weight:900; color:#f0c75e;
                 line-height:1; font-variant-numeric:tabular-nums; }
  .champ-score small { font-size:16px; font-weight:400; color:#9fb8d6; margin-left:4px; }
  .champ-ci { font-size:12.5px; color:#9fb8d6; margin-top:6px; }
  /* 大温度计：分数=水银柱，金色须=90%置信区间 */
  .thermo { position:relative; }
  .thermo .tube { position:absolute; left:0; right:0; top:5px; bottom:5px;
                  background:rgba(120,150,185,.22); border-radius:99px; overflow:hidden; }
  .thermo .tube b { position:absolute; left:0; top:0; bottom:0; width:var(--v,0%);
                    border-radius:99px;
                    background:linear-gradient(90deg,#3f7cc0,#7db4e0); }
  .thermo .tube::after { content:""; position:absolute; inset:0;
      background:repeating-linear-gradient(90deg,transparent 0,transparent calc(25% - 1px),
                 rgba(255,255,255,.5) calc(25% - 1px),rgba(255,255,255,.5) 25%); }
  .thermo .err { position:absolute; top:-2px; bottom:-2px; left:var(--lo,0%);
                 width:calc(var(--hi,0%) - var(--lo,0%)); }
  .thermo .err::before { content:""; position:absolute; left:0; top:0; bottom:0; width:2px;
                 background:#f0c75e; border-radius:2px; }
  .thermo .err::after  { content:""; position:absolute; right:0; top:0; bottom:0; width:2px;
                 background:#f0c75e; border-radius:2px; }
  .thermo.lg { height:30px; margin-top:18px; }
  .champ-honest { margin-top:16px; padding-top:12px;
                  border-top:1px dashed rgba(154,193,236,.3);
                  font-size:12.5px; color:#a9c0dc; line-height:1.8; }
  .champ-honest b { color:#dce8f6; }
  .champ-empty { padding:26px; font-size:15px; color:#c4d5ea; }

  /* ================= 主体布局 ================= */
  .wrap { max-width:1120px; margin:0 auto; padding:10px 22px 46px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
          padding:26px 28px; margin:20px 0; box-shadow:var(--shadow); }
  .eyebrow { font-size:11.5px; letter-spacing:2.5px; color:var(--muted);
             margin:0 0 6px; font-weight:600; }
  .card > h2 { font-size:21px; margin:0 0 6px; letter-spacing:.5px; }
  .card .desc { color:var(--muted); font-size:13.5px; margin:0 0 16px; max-width:900px; }
  .hint { background:var(--blue-soft); border-left:3px solid var(--blue); border-radius:8px;
          color:#28466b; font-size:12.5px; padding:8px 13px; margin:12px 0 0; }
  .hint b { color:var(--blue-deep); }

  /* ================= 总榜：观测簿式表格 ================= */
  .lb-scroll { overflow-x:auto; border:1px solid var(--line); border-radius:12px; }
  .lb-table { border-collapse:collapse; width:100%; font-size:13px; min-width:920px; }
  .lb-table th, .lb-table td { border-bottom:1px solid var(--line-soft);
        padding:8px; white-space:nowrap; text-align:right;
        font-variant-numeric:tabular-nums; }
  .lb-table th { background:#f6f8fb; color:#42536e; font-weight:600; font-size:12px; }
  .lb-table th[data-key] { cursor:pointer; user-select:none; }
  .lb-table th[data-key]:hover { color:var(--blue); }
  .lb-table th .ind { color:var(--blue); font-size:9px; margin-left:2px; }
  .lb-table th.l, .lb-table td.l { text-align:left; }
  .lb-table .c-rk { width:44px; text-align:center; color:var(--muted); font-weight:700; }
  .lb-table .c-name { position:sticky; left:0; background:#fff; z-index:1;
                      min-width:172px; border-right:1px solid var(--line-soft);
                      padding-left:14px; }
  .lb-table th.c-name { background:#f6f8fb; }
  .dot { display:inline-block; width:9px; height:9px; border-radius:50%;
         margin-right:8px; vertical-align:0; }
  .lb-table .c-name b { color:var(--ink); font-size:13.5px; }
  .lb-table .c-name .mid { color:#9aa8bd; font-size:10.5px; margin-left:6px; }
  .dagger { color:var(--muted); font-weight:700; cursor:help; margin-left:2px; }
  .warn-badge { cursor:help; }
  tr.is-top td { background:#fdfaf1; }
  tr.is-top .c-name { background:#fdfaf1; }
  tr.is-top td.c-rk { color:var(--gold); }
  tr.is-weak td { color:#9aa8bd; }
  tr.is-weak .c-name b { color:#9aa8bd; }
  .lb-table tbody tr:hover td { background:#f4f8fc; }
  .lb-table tr.is-top:hover td { background:#faf3dd; }
  tr.is-weak:hover td { background:#f4f8fc !important; }
  /* 温度计得分条（表格版） */
  .thermo.sm { height:18px; min-width:116px; }
  .c-score { min-width:168px; }
  .c-score .cell { display:flex; align-items:center; gap:8px; }
  .c-score .cell .thermo { flex:1; }
  .score-num { font-weight:700; color:var(--ink); min-width:30px; text-align:right; }
  tr.is-weak .score-num { font-weight:400; }
  .c-spark svg { display:block; }
  .c-spark { min-width:110px; }
  .ci-cell { color:var(--muted); font-size:12px; }

  /* ================= 折叠区（方法论 / 词典 / 机制） ================= */
  .fold { border:1px solid var(--line); border-radius:12px; background:#fbfcfe;
          margin-top:12px; }
  .fold > summary { cursor:pointer; list-style:none; padding:12px 16px; font-size:13.5px;
                    font-weight:600; color:var(--ink); }
  .fold > summary::-webkit-details-marker { display:none; }
  .fold > summary::after { content:"展开 ▸"; float:right; font-size:12px;
                           color:var(--muted); font-weight:400; }
  .fold[open] > summary::after { content:"收起 ▾"; }
  .fold .fold-body { padding:2px 16px 16px; border-top:1px solid var(--line-soft); }
  .fold h3 { font-size:14.5px; margin:16px 0 6px; }
  .fold p.why { font-size:12.5px; color:var(--muted); margin:6px 0; line-height:1.8; }
  .weights-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));
                  gap:6px 22px; }
  table.plain { border-collapse:collapse; width:100%; font-size:12px; background:#fff;
                border:1px solid var(--line-soft); }
  table.plain th, table.plain td { border:1px solid var(--line-soft); padding:5px 8px;
                text-align:center; white-space:nowrap; font-variant-numeric:tabular-nums; }
  table.plain th { background:#f6f8fb; color:#42536e; }
  table.plain td.l, table.plain th.l { text-align:left; }

  /* ================= 图表卡通用 ================= */
  .chart { width:100%; height:380px; margin-top:4px; }
  .chart-fallback { display:flex; align-items:center; justify-content:center; height:180px;
                    color:var(--muted); background:#f7f9fc; border:1px dashed var(--line);
                    border-radius:12px; font-size:13px; }
  .controls { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:2px 0 12px; }
  .controls label { font-size:12.5px; color:var(--muted); }
  select { padding:6px 10px; border:1px solid var(--line); border-radius:9px; font-size:13px;
           background:#fff; color:var(--slate); margin:0; max-width:240px; }
  .seg { display:inline-flex; border:1px solid var(--line); border-radius:9px;
         overflow:hidden; background:#fff; }
  .seg button { border:none; background:#fff; color:var(--muted); font-size:12.5px;
                padding:6px 13px; cursor:pointer; }
  .seg button + button { border-left:1px solid var(--line); }
  .seg button.on { background:var(--ink); color:#fff; }
  .metric-note { font-size:12px; color:var(--muted); }

  /* ================= 选源面板（按源家族分组的复选框） ================= */
  .picker { position:relative; }
  .picker-btn { border:1px solid var(--line); border-radius:9px; background:#fff;
                color:var(--slate); font-size:12.5px; padding:6px 12px; cursor:pointer; }
  .picker-btn b { font-variant-numeric:tabular-nums; }
  .picker-btn:hover { border-color:var(--blue); color:var(--blue-deep); }
  .picker-panel { position:absolute; z-index:30; top:calc(100% + 6px); left:0;
                  width:300px; max-height:340px; overflow:auto; background:#fff;
                  border:1px solid var(--line); border-radius:12px;
                  box-shadow:0 10px 30px rgba(12,35,64,.16); padding:10px 12px; }
  .picker-quick { display:flex; gap:6px; margin-bottom:8px; }
  .picker-quick button { flex:1; border:1px solid var(--line); border-radius:8px;
                         background:#f6f8fb; color:var(--slate); font-size:12px;
                         padding:4px 0; cursor:pointer; }
  .picker-quick button:hover { border-color:var(--blue); color:var(--blue-deep); }
  .picker-fam { font-size:11px; color:var(--muted); letter-spacing:1px;
                margin:9px 0 3px; font-weight:600; }
  .picker-item { display:flex; align-items:center; gap:7px; font-size:12.5px;
                 padding:2.5px 2px; border-radius:6px; cursor:pointer; }
  .picker-item:hover { background:var(--blue-soft); }
  .picker-item input { margin:0; accent-color:var(--blue); }
  .picker-item .dot { margin:0; }

  /* ================= 词典 ================= */
  .glossary { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));
              gap:2px 30px; margin:0; }
  .glossary > div { padding:8px 0; border-bottom:1px dashed var(--line-soft); }
  .glossary dt { font-weight:700; font-size:13px; color:var(--ink); }
  .glossary dd { margin:2px 0 0; font-size:12.5px; color:var(--muted); }

  /* ================= 页脚 ================= */
  .archive-list { display:flex; flex-wrap:wrap; gap:10px; margin:8px 0 0; }
  .archive-list a { display:inline-block; border:1px solid var(--line); border-radius:10px;
                    padding:7px 15px; color:var(--blue); text-decoration:none; font-size:13.5px;
                    background:#fff; }
  .archive-list a:hover { border-color:var(--blue); background:var(--blue-soft); }
  .steps { margin:8px 0 0; padding-left:0; list-style:none; counter-reset:step; }
  .steps li { position:relative; padding:5px 0 5px 36px; font-size:13px; color:var(--slate);
              counter-increment:step; }
  .steps li::before { content:counter(step); position:absolute; left:0; top:7px;
              width:22px; height:22px; border-radius:50%; background:var(--ink); color:#fff;
              font-size:12px; font-weight:700; text-align:center; line-height:22px; }
  footer { text-align:center; color:var(--muted); font-size:12.5px;
           padding:8px 20px 40px; line-height:2; }
  footer .merkle { word-break:break-all; font-size:11px; color:#8794a8; }
  .back-home { display:inline-block; margin-bottom:10px; color:#9fc3e8; font-size:13px;
               text-decoration:none; }
  .back-home:hover { text-decoration:underline; }

  /* ================= 手机窄屏（≤760px）=================
     这里不是"把宽版等比缩小"，而是按手机真正擅长的事重排：
       1. 总榜从 10 列表格改成逐源卡片——宽表在手机上必然横滑，而横滑会把
          「综合分」这一页唯一的答案滑出屏幕；
       2. 图表让出被右侧名签吃掉的留白，并给热力图加一条可拖动的日期滑块；
       3. 选源面板改成贴底浮层，弹出框不会再跑出屏幕外；
       4. 折叠区里那些"公式 + 数字"的长表格允许换行，卡片不被撑破。
     服务端渲染的表结构原样保留（只是 display 变了），因此"榜单可读"这条
     硬约束不依赖 JS，排序与榜单切换也照常工作。 */
  @media (max-width:760px) {
    /* ---- 排版与留白：两侧收窄、字号降一档 ---- */
    .wrap { padding:8px 14px 40px; }
    .card { padding:20px 15px; margin:14px 0; }
    .card > h2 { font-size:19px; }
    .card .desc { font-size:13px; }
    .hint { font-size:12px; }
    .hero-inner { padding:34px 15px 46px; }
    .hero h1 { font-size:28px; letter-spacing:1px; }
    .hero .lede { font-size:14px; margin-bottom:20px; }
    .hero-curve { height:120px; }
    .champ { grid-template-columns:1fr; padding:16px 15px; gap:14px; }
    .champ-score-box { text-align:left; }
    .champ-name { font-size:25px; }
    .champ-facts { gap:5px 16px; font-size:13px; }
    .champ-score { font-size:46px; }
    .champ-honest { font-size:12px; }
    .chart { height:300px; }
    .only-wide { display:none !important; }
    .only-mobile { display:inline; }

    /* ---- 触控目标：下拉/分段/复选框抬到 36px 以上，指头点得中 ---- */
    select, .seg button, .picker-btn { min-height:36px; }
    .controls { gap:8px; }
    .controls select { max-width:none; flex:1 1 140px; }
    .seg button { padding:7px 12px; }

    /* ---- 选源面板：贴底浮层（固定在视口内，与按钮位置无关） ---- */
    .picker-panel { position:fixed; left:0; right:0; bottom:0; top:auto;
                    width:auto; max-width:none; max-height:65vh;
                    border-radius:16px 16px 0 0;
                    padding-bottom:calc(14px + env(safe-area-inset-bottom,0px));
                    box-shadow:0 -12px 34px rgba(12,35,64,.24); }

    /* ---- §01 总榜：表格 → 逐源卡片 ---- */
    .lb-scroll { overflow:visible; border:0; border-radius:0; }
    .lb-table { display:block; min-width:0; font-size:13.5px; }
    .lb-table thead { display:none; }
    .lb-table tbody { display:block; }
    .lb-table tr { display:block; border:1px solid var(--line); border-radius:12px;
                   background:#fff; padding:12px 14px; margin:0 0 10px; }
    .lb-table tr.is-top { border-color:var(--gold-line); }
    .lb-table td { display:inline; border:0; padding:0; min-width:0; white-space:normal;
                   text-align:left; }
    /* 桌面端的单元格底色（白底粘性列、行悬浮）在卡片里全都要让位给卡片本身 */
    .lb-table tbody tr td, .lb-table tbody tr:hover td, .lb-table tr.is-top td,
    .lb-table tr.is-top:hover td, .lb-table tr.is-weak:hover td { background:transparent; }
    .lb-table .c-rk { display:inline-block; min-width:20px; margin-right:4px;
                      color:var(--muted); }
    .lb-table .c-name { position:static; border:0; padding:0; min-width:0; }
    .lb-table .c-name b { font-size:15px; }
    .lb-table .c-name .mid { display:none; }   /* 原始模型 id 留给宽屏 */
    .lb-table .c-score { display:block; margin:10px 0 7px; }
    .lb-table .c-score .cell { gap:10px; }
    .lb-table .c-score .thermo { min-width:0; }
    .lb-table .c-score .score-num { font-size:21px; min-width:54px;
                                    font-variant-numeric:tabular-nums; }
    .lb-table .c-spark { display:none; }       /* 走势留给 §02 的衰减曲线 */
    /* 其余指标折成一行小字，标签由 data-label 提供（服务端与前端生成的行共用）。
       inline-block + nowrap 让「标签 数值」成为一个整体换行单元——
       否则行尾会在「晴雨TS」与它后面的 0.33 之间断开，读起来像是漏了一项。 */
    .lb-table td[data-label] { display:inline-block; white-space:nowrap;
                               margin-right:12px; font-size:12.5px; color:var(--slate); }
    .lb-table td[data-label]::before { content:attr(data-label) " "; color:var(--muted); }

    /* ---- 折叠区：诊断类长表格在手机上改为可横向滚动。body 是 overflow-x:clip，
         7 列的表（如「名义 vs 实际」）会顶出卡片、最后一列被裁掉且无法滚到，
         所以这里给表格自己一条滚动条，并把字距收紧尽量少滚。 ---- */
    table.plain { display:block; overflow-x:auto; -webkit-overflow-scrolling:touch;
                  max-width:100%; }
    table.plain th, table.plain td { white-space:normal; padding:4px 6px; font-size:11.5px; }
  }
</style>
</head>
<body>

{# ================= 服务端预计算：冠军与诚实披露的全部数字 ================= #}
{% set lb_all = (report.leaderboards or {}).get('all', []) %}
{% set lb1 = (report.leaderboards or {}).get('hourly:1d', []) %}
{% set ns = namespace(champ=none, fallback=false) %}
{% set champ_q = lb_all | selectattr('qualified') | selectattr('score') | list %}
{% if champ_q %}
  {% set ns.champ = champ_q[0] %}
{% else %}
  {% set lb1_q = lb1 | selectattr('temp_score') | selectattr('precip_score') | selectattr('score') | list %}
  {% if lb1_q %}{% set ns.champ = lb1_q[0] %}{% set ns.fallback = true %}{% endif %}
{% endif %}
{% set champ = ns.champ %}
{# 与第一名置信区间重叠（= 统计上并列）的源数 #}
{% set ns2 = namespace(lo=champ.get('ci90')[0] if champ and champ.get('ci90') else none,
                       hi=champ.get('ci90')[1] if champ and champ.get('ci90') else none,
                       tied=0) %}
{% for r in lb_all %}
  {% if r.get('ci90') and r.get('score') is not none and ns2.lo is not none
        and not (r.get('ci90')[1] < ns2.lo or r.get('ci90')[0] > ns2.hi) %}
    {% set ns2.tied = ns2.tied + 1 %}
  {% endif %}
{% endfor %}
{% set cw = [] %}
{% for r in lb_all %}{% if r.get('ci90') %}{% set _ = cw.append(r.get('ci90')[1] - r.get('ci90')[0]) %}{% endif %}{% endfor %}
{% set cw_sorted = cw | sort %}
{% set rs = ((report.meta.get('difficulty_window') or {}).get('all') or {}).get('rank_sensitivity') or {} %}
{% set ws = report.meta.get('weight_sensitivity') or {} %}
{% set integ = report.meta.get('integrity') or {} %}
{% macro pct(v) %}{{ '—' if v is none else '%.1f%%'|format(v) }}{% endmacro %}
{% macro num(v, d=1) %}{{ '—' if v is none else ('%.' ~ d ~ 'f')|format(v) }}{% endmacro %}
{% macro thermo(score, ci, cls) %}
  <div class="thermo {{ cls }}">
    <span class="tube"><b style="--v:{{ ([100, ([score, 0]|max if score is not none else 0)]|min) }}%"></b></span>
    {% if ci %}<span class="err" title="90% 置信区间 {{ num(ci[0]) }} ~ {{ num(ci[1]) }}"
      style="--lo:{{ [100, [ci[0], 0]|max]|min }}%;--hi:{{ [100, [ci[1], 0]|max]|min }}%"></span>{% endif %}
  </div>
{% endmacro %}

<!-- ==================== Hero：答案 ==================== -->
<header class="hero">
  <div class="hero-curve">{{ hero_curve | safe }}</div>
  <div class="hero-inner">
    {% if report.meta.is_monthly %}
    <a class="back-home" href="{{ base }}index.html">← 返回实时总榜</a><br>
    <span class="hero-badge">🗂️ 月度归档 · 数据已冻结</span>
    {% else %}
    <span class="hero-badge">🤖 自动检验 · 每天 6:00 / 13:00 / 20:00（北京时）更新</span>
    {% endif %}
    <h1>谁家天气预报<span class="q">最准</span>？</h1>
    <p class="lede">把 <b>{{ report.meta.models|length }} 家预报源</b>与
      <b>{{ report.meta.stations|length }} 个气象站的逐小时实况</b>逐时对账。
      这是 {% if report.meta.is_monthly %}{{ report.meta.period_label }} 月{% else %}{{ report.meta.period_label }}{% endif %}
      的对账结果——预报先封存、后验证，不看谁嗓门大，只看谁报得准。</p>

    {% if champ %}
    <div class="champ">
      <div>
        <div class="champ-kicker">综合表现领先</div>
        <div class="champ-name">
          <i class="dot" style="background:{{ model_colors.get(champ.model, '#64748b') }}"></i>
          {{ model_labels.get(champ.model, champ.model) }}
          {% if champ.get('sig_vs_top') is sameas false and not ns.fallback %}
          <sup class="dagger" style="color:#f0c75e" title="与其他源的差距经统计检验仍不显著">†</sup>{% endif %}
          {% if champ.get('disputed') %}
          <span class="warn-badge" title="{{ (champ.get('disputed_reasons') or [])|join('；') }}">⚠️ 口径存疑</span>
          {% endif %}
        </div>
        <div class="champ-facts">
          <span><span class="lab">温度分</span><b>{{ num(champ.temp_score) }}</b></span>
          <span><span class="lab">降水分</span><b>{{ num(champ.precip_score) }}</b></span>
          <span><span class="lab">±2°C 准确率</span><b>{{ pct(champ.acc2) }}</b></span>
          <span><span class="lab" title="小时晴雨与日累计晴雨两轨拼接后、经难度对齐的行效应">晴雨 TS（两轨对齐）</span><b>{{ num(champ.ts, 2) }}</b></span>
          {% if champ.lead_days %}<span><span class="lab">覆盖预报至</span><b>提前 {{ champ.lead_days }} 天</b></span>{% endif %}
        </div>
        <div class="champ-honest">
          📏 <b>读榜须知：</b>样本期 {{ report.meta.bootstrap_days }} 天，分块重采样
          {{ report.meta.bootstrap_runs }} 次的 90% 置信区间中位宽
          <b>{{ '%.1f'|format(cw_sorted[cw_sorted|length // 2]) if cw_sorted else '—' }} 分</b>{% if ns2.tied > 1 %}，
          与第一名<b>统计上并列</b>的有 {{ ns2.tied - 1 }} 家——前后名次未必是一分高下{% endif %}；
          {% if ws.get('champions') %}把 12 项评分权重随机扰动 ±40% 重复 {{ ws.runs }} 次，
          冠军归属：<b>{% for c in ws.champions[:2] %}{{ model_labels.get(c.model, c.model) }} {{ c.pct }}%{% if not loop.last %} / {% endif %}{% endfor %}</b>；
          {% endif %}名字带 † = 差距在统计上还分不开。<a href="#board" style="color:#9fc3e8">看完整榜单 →</a>
        </div>
      </div>
      <div class="champ-score-box">
        {% if ns.fallback %}<div class="champ-ci">提前 1 天（小时口径）得分 · 数据积累中</div>
        {% else %}<div class="champ-ci">难度对齐综合分 · 0~100</div>{% endif %}
        <div class="champ-score">{{ num(champ.score) }}<small>分</small></div>
        {{ thermo(champ.score, champ.get('ci90'), 'lg') }}
        <div class="champ-ci">{% if champ.get('ci90') %}90% 置信区间
          {{ num(champ.get('ci90')[0]) }} ~ {{ num(champ.get('ci90')[1]) }} 分{% endif %}</div>
      </div>
    </div>
    {% else %}
    <div class="champ champ-empty">🌱 数据积累中——样本攒够后，这里会公布"预报冠军"。</div>
    {% endif %}
  </div>
</header>

<div class="wrap">

  <!-- ==================== §01 总榜 ==================== -->
  <section class="card" id="board">
    <p class="eyebrow">§01 · 证据</p>
    <h2>预报源总榜</h2>
    <p class="desc">「综合分」由温度 7 项 + 降水 5 项指标加权而成，并且先把每一档提前量的
      难度统一扣掉再比——能报 3 天的和能报 15 天的同榜也公平。<span class="only-wide">点任意列名可重新排序；
      「得分走势」是综合分随提前天数（1~16 天，小时口径）的衰减，<b>谁在右边还站得高，谁的长期预报就更可靠</b>。</span><span class="only-mobile">每个源一张卡片：大字是综合分，
      下面一行是它的分项。</span>
      想看某个具体提前量的排名，用下面的<b>榜单下拉</b>切到「提前 N 天」分榜——同一档内直接对照、不经难度对齐。</p>
    <div class="controls">
      <label for="lbBoard">榜单</label>
      <select id="lbBoard" aria-label="选择榜单"></select>
      <span class="metric-note" id="lbNote"></span>
    </div>
    <div class="lb-scroll">
      <table class="lb-table" id="lbTable">
        <thead><tr>
          <th class="c-rk">#</th>
          <th class="l c-name">预报源</th>
          <th data-key="score" data-type="num" data-dir="desc">综合分<span class="ind">▼</span></th>
          <th data-key="temp" data-type="num">温度分</th>
          <th data-key="precip" data-type="num">降水分</th>
          <th data-key="acc2" data-type="num">±2°C 准确率</th>
          <th data-key="ts" data-type="num" id="lbTsHead">晴雨 TS（两轨对齐）</th>
          <th data-key="lead" data-type="num">覆盖时效</th>
          <th>90% 置信区间</th>
          <th class="l">得分走势</th>
        </tr></thead>
        <tbody id="lbBody">
        {% for r in lb_all %}
        {% set c = model_colors.get(r.model, '#64748b') %}
        <tr class="{% if r.get('is_top') %}is-top {% endif %}{% if not r.get('qualified') %}is-weak{% endif %}"
            data-m="{{ r.model }}"
            data-rk="{{ loop.index }}"
            data-score="{{ r.get('score') if r.get('score') is not none else '' }}"
            data-temp="{{ r.get('temp_score') if r.get('temp_score') is not none else '' }}"
            data-precip="{{ r.get('precip_score') if r.get('precip_score') is not none else '' }}"
            data-acc2="{{ r.get('acc2') if r.get('acc2') is not none else '' }}"
            data-ts="{{ r.get('ts') if r.get('ts') is not none else '' }}"
            data-lead="{{ r.get('lead_days') if r.get('lead_days') else '' }}">
          <td class="c-rk num">{{ loop.index }}</td>
          <td class="l c-name"><i class="dot" style="background:{{ c }}"></i><b>{{ model_labels.get(r.model, r.model) }}</b>
            {%- if r.get('sig_vs_top') is sameas false %}<sup class="dagger" title="与第一名的差距经 Holm–Bonferroni 校正后仍不显著：前后名次更多是抽样运气">†</sup>{% endif -%}
            {%- if r.get('disputed') %}<span class="warn-badge" title="{{ (r.get('disputed_reasons') or [])|join('；') }}">⚠️</span>{% endif -%}
            <span class="mid">{{ r.model }}</span>
            {% if not r.get('qualified') %}<span class="mid">· 样本积累中</span>{% endif %}
          </td>
          <td class="c-score"><div class="cell">
            {{ thermo(r.get('score'), r.get('ci90'), 'sm') }}
            <b class="score-num">{{ num(r.get('score')) }}</b></div></td>
          <td data-label="温度">{{ num(r.get('temp_score')) }}</td>
          <td data-label="降水">{{ num(r.get('precip_score')) }}</td>
          <td data-label="±2°C">{{ pct(r.get('acc2')) }}</td>
          <td data-label="晴雨TS">{{ num(r.get('ts'), 2) }}</td>
          <td data-label="覆盖">{% if r.get('lead_days') %}{{ r.lead_days }} 天{% if r.get('lead_temp_days') and r.get('lead_rain_days') and r.lead_temp_days != r.lead_rain_days %}<span class="mid" title="覆盖时效按维核计：温度维最远 {{ r.lead_temp_days }} 天、降水维 {{ r.lead_rain_days }} 天（两维不等时，数字取两维最远）">温{{ r.lead_temp_days }}·雨{{ r.lead_rain_days }}</span>{% endif %}{% else %}—{% endif %}</td>
          <td class="ci-cell" data-label="90%CI">{% if r.get('ci90') %}{{ num(r.get('ci90')[0]) }}~{{ num(r.get('ci90')[1]) }}{% else %}—{% endif %}</td>
          <td class="l c-spark">{{ spark_svg.get(r.model, '') | safe }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="hint">💡 <b>怎么看：</b>综合分的<b>金色须线</b>是 90% 置信区间——须线重叠的两家，
      先后在统计上还说不清；名字带 <b>†</b> 同理。<b>覆盖时效</b>是这家实际参与计算的样本最远覆盖到的提前量；
      温度维与降水维分别核计，两维不等时数字后括注（如「温16·雨5」：逐日预报产品把温度维带到 16 天，
      降水维仍止于逐小时的 5 天）——该行综合分的桶覆盖范围见下方「难度对齐」折叠区。
      残缺的误差类指标（RMSE 等）越低越好。</p>

    {% set dw = ((report.meta.get('difficulty_window') or {}).get('all') or {}) %}
    {% if report.meta.model_caveats %}
    <details class="fold"><summary>⚠️ 有几家的数字要带着"口径注记"读</summary>
      <div class="fold-body">
        {% for m, note in report.meta.model_caveats.items() %}
        <p class="why"><b>{{ model_labels.get(m, m) }}</b>：{{ note }}。名次请结合这一差异解读。</p>
        {% endfor %}
        {% set no_data = [] %}
        {% set truncated = [] %}
        {% for m, st in (report.meta.get('model_status') or {}).items() %}{% if st != 'ok' %}{% set _ = no_data.append(m) %}{% endif %}{% endfor %}
        {% for m, q in (report.meta.get('snapshot_quality') or {}).items() %}{% if q.get('truncated') %}{% set _ = truncated.append((m, q)) %}{% endif %}{% endfor %}
        {% if no_data %}<p class="why"><b>从未产出数据</b>（多为需要凭据/尚未接入，榜上无分 ≠ 报得差）：
          {% for m in no_data %}{{ model_labels.get(m, m) }}{% if not loop.last %}、{% endif %}{% endfor %}。</p>{% endif %}
        {% if truncated %}<p class="why"><b>有残缺快照</b>（序列不完整的存档，样本对时间覆盖更薄）：
          {% for m, q in truncated %}{{ model_labels.get(m, m) }} {{ q.truncated }}/{{ q.snapshots }} 份{% if not loop.last %}、{% endif %}{% endfor %}。</p>{% endif %}
        {% set cspan = report.meta.get('calendar_span') or {} %}
        {% if cspan.get('min_days') and cspan.get('max_days') and cspan['max_days'] >= cspan['min_days'] + 3 %}
        <p class="why">各源被验证的自然日数相差较大（{{ cspan.min_days }}~{{ cspan.max_days }} 天）——
          新源只在自己入榜之后的日子里受检，请结合「覆盖时效」列解读。</p>
        {% endif %}
      </div>
    </details>
    {% endif %}

    <details class="fold"><summary>🧮 综合分怎么算：12 项指标的加权构成</summary>
      <div class="fold-body">
        <div class="weights-grid">
          <div>
            <h3>🌡️ 温度分（7 项）</h3>
            <table class="plain">
              <thead><tr><th class="l">指标</th><th>权重</th><th class="l">0~100 换算</th></tr></thead>
              <tbody>{% for p in score_temp_parts %}
                <tr><td class="l">{{ p.label }}</td><td>{{ p.pct }}%</td><td class="l">{{ p.map }}</td></tr>
              {% endfor %}</tbody>
            </table>
            <p class="why">不入分：RSS、χ²（样本量的函数，不是预报技巧）。</p>
          </div>
          <div>
            <h3>🌧️ 降水分（5 项，日雨量 ≥{{ report.meta.rain_daily_threshold_mm }}mm 口径）</h3>
            <table class="plain">
              <thead><tr><th class="l">指标</th><th>权重</th><th class="l">0~100 换算</th></tr></thead>
              <tbody>{% for p in score_precip_parts %}
                <tr><td class="l">{{ p.label }}</td><td>{{ p.pct }}%</td><td class="l">{{ p.map }}</td></tr>
              {% endfor %}</tbody>
            </table>
            <p class="why">不入分：晴雨准确率（由气候基率主导，ETS 已校正）、雨量误差
              （被个别强降水时段主导，跨源比较不公平）。</p>
          </div>
        </div>
        <p class="why">某项缺数据时按<b>剩余权重</b>折算（缺数据 ≠ 差数据）；综合分 = 温度分与降水分各半。</p>
      </div>
    </details>

    <details class="fold"><summary>📏 「能报 3 天的和能报 15 天的」为什么能同榜：难度对齐与名次的稳健性</summary>
      <div class="fold-body">
        <p class="why">越往后越难报，而各家能报的天数差很多：直接平均"自己覆盖的那几档"，
          只报近几天的源白拿简单档的分。本页用<b>双向加法劈分</b>——把「（源 × 档位）」看成
          <b>分数 = 这家水平 + 这一档难度 + 噪声</b>，用全部格子一起估出行、列效应，
          数据一格不扔，也不要求各家覆盖一致。</p>
        {% if dw.get('degraded') %}
        <p class="why">⚠️ 本份报告已降级为"各源可用天桶的等权平均"（可用格子凑不出能横向比较的表），
          请结合「覆盖时效」列解读。</p>
        {% endif %}
        <p class="why"><b>这份名次有多结实？</b>
          ① 格子按 √(有效样本量) 加权，过薄格子剔除{% if dw.get('dropped_thin_cells') %}（本轮剔除 {{ dw.dropped_thin_cells }} 个）{% endif %}；
          {% if rs.get('spearman') is not none %}② 换成等权口径重算，名次 Spearman = <b>{{ '%.2f'|format(rs.spearman) }}</b>{% if rs.get('top10_changed') is not none %}（前十换 {{ rs.top10_changed }} 家）{% endif %}；
          {% endif %}{% if dw.get('variance') and dw['variance'].get('residual_share') is not none %}③ 分数方差拆解：源间
          {{ '%.0f%%'|format(dw['variance']['row_share'] * 100) }} · 档位难度
          {{ '%.0f%%'|format(dw['variance']['col_share'] * 100) }} · 交互与噪声
          {{ '%.0f%%'|format(dw['variance']['residual_share'] * 100) }}——残差占比越高，"一个数字排座次"抹掉的真实差异越多；
          {% endif %}④ 有效样本量已扣除时间自相关与跨站相关（相邻站由同一批天气系统驱动，直接相加会高估约 1.7 倍）。</p>
      </div>
    </details>

    {% if report.meta.get('issue_anchors') %}
    <details class="fold"><summary>🧭 各源的"起报时刻"到底是什么（口径存疑 ⚠️ 的出处）</summary>
      <div class="fold-body">
        <p class="why">同一个「提前 N 天」，各家用的起报锚点并不都是同一回事。
          若锚点实质接近抓取时刻，声明的时效会系统性地长于实际时效——这样的源在榜上挂 ⚠️。</p>
        <table class="plain">
          <thead><tr><th class="l">预报源</th><th class="l">起报锚点语义</th><th class="l">口径存疑</th></tr></thead>
          <tbody>{% for m, ia in report.meta.issue_anchors.items() %}
            {% if ia.get('issue_source') and (ia.get('issue_source') != 'unknown' or ia.get('issue_source_undeclared')) %}
            <tr><td class="l">{{ model_labels.get(m, m) }}</td>
              <td class="l">{{ ia.get('issue_source_label') or '—' }}{% if ia.get('issue_source_undeclared') %}（另有 {{ ia.issue_source_undeclared }} 份历史存档未声明，随归档递减）{% endif %}</td>
              <td class="l">{% if ia.get('disputed') %}⚠️ {{ ia.get('disputed_reasons')|join('；') }}{% else %}—{% endif %}</td></tr>
            {% endif %}
          {% endfor %}</tbody>
        </table>
      </div>
    </details>
    {% endif %}
  </section>

  <!-- ==================== §02 得分衰减 ==================== -->
  <section class="card" id="decay">
    <p class="eyebrow">§02 · 理解</p>
    <h2>得分随时效衰减：谁"掉秤"掉得慢？</h2>
    <p class="desc">把每一档提前量的得分连成曲线。灰色地带是全体源的波动范围（虚线 = 中位），
      默认画总榜前三名；<b>选源面板</b>按源家族分组勾选，或直接点图例增删。
      <b>小时口径</b>答"某日几点准不准"，<b>日口径</b>答"这一天的极值/总量准不准"，
      两条曲线口径不同、不能互相比斜率；<b>综合口径</b>是同一提前天数上两种口径
      分数各半的合成（两轨缺一即缺），与榜单下拉里的「综合 · 提前 N 天」同口径。</p>
    <div class="controls">
      <div class="seg" id="segTrack">
        <button class="on" data-v="hourly">⏱️ 小时口径</button>
        <button data-v="daily">📅 日口径</button>
        <button data-v="all">🧩 综合口径</button>
      </div>
      <div class="seg" id="segDim">
        <button class="on" data-v="overall">综合</button>
        <button data-v="temp">温度</button>
        <button data-v="precip">降水</button>
      </div>
      <div class="picker" id="decayPicker"></div>
    </div>
    <div id="chartDecay" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b>线向右下掉是自然规律（越远越难报）；谁在右边还站得高，
      谁的长期预报就更可靠。线中断 = 该时效样本不足。</p>
  </section>

  <!-- ==================== §03 温度 / 降水 ==================== -->
  <section class="card" id="wx">
    <p class="eyebrow">§03 · 理解</p>
    <h2>温度与降水，分别准在哪？</h2>
    <p class="desc">按提前天数（1~16 天）展开的单项指标。<b>逐小时口径</b>看"这一小时的
      温度/雨报得如何"，<b>日口径</b>看"这一天的日最高/最低温与 24h 累计雨报得如何"。
      默认看总榜前三名，<b>选源面板</b>按源家族分组勾选，或直接点图例增删；
      温度与降水两页签可切换，指标下拉可换视角。</p>
    <div class="controls">
      <div class="seg" id="segWxTrack">
        <button class="on" data-v="hourly">⏱️ 逐小时</button>
        <button data-v="daily">📅 日口径</button>
      </div>
      <div class="seg" id="segWx">
        <button class="on" data-v="temp">🌡️ 温度</button>
        <button data-v="rain">🌧️ 降水</button>
      </div>
      <div class="seg" id="segWxHalf" hidden>
        <button class="on" data-v="max">日最高</button>
        <button data-v="min">日最低</button>
      </div>
      <label for="wxMetric">指标</label>
      <select id="wxMetric" aria-label="选择指标"></select>
      <div class="picker" id="wxPicker"></div>
      <span class="metric-note" id="wxNote"></span>
    </div>
    <div id="chartWx" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b>准确率/相关系数<b>越高越好</b>，RMSE/MAE/空报率<b>越低越好</b>；
      MBE 越接近 0 越好（正 = 习惯性报偏高，负 = 报偏低）；BIAS 越接近 1 越好。
      日口径的降水为北京时自然日 24h 累计 ≥{{ report.meta.rain_daily_threshold_mm }}mm 的晴雨；
      降水比温度难报得多，TS 到 0.3~0.5 已属正常水平。</p>
  </section>

  <!-- ==================== §04 每日热力图 ==================== -->
  <section class="card" id="heat">
    <p class="eyebrow">§04 · 理解</p>
    <h2>每一天的对账结果</h2>
    <p class="desc">每个格子 = 某天 × 某家预报源的当日表现，行按总榜名次排列。
      <b>绿</b> = 准，<b>红</b> = 翻车，空白 = 数据不足。温度与降水两要素可切换，
      指标下拉含两族全部指标（温度：±1/±2°C、RMSE、MAE、|MBE|；
      降水为该天逐小时 ≥1mm 时雨的晴雨评分：TS/ETS/晴雨准确率/POD/FAR）。</p>
    <div class="controls">
      <div class="seg" id="segHeat">
        <button class="on" data-v="temp">🌡️ 温度</button>
        <button data-v="rain">🌧️ 降水</button>
      </div>
      <label for="heatMetric">指标</label>
      <select id="heatMetric" aria-label="选择指标"></select>
    </div>
    <div id="chartHeat" class="chart"></div>
    <p class="hint">💡 <b>怎么看：</b>整列发红往往是天气突变（大家都难），<b>整行偏红才是这家整体拉胯</b>；
      降水的 TS 天然比温度准确率低一截（雨是否下在那一刻本来就难报），请按行内相对高低读。<span class="only-mobile">手机上格子很密，可拖动图表下方的滑块，只放大看某几天。</span></p>
  </section>

  <!-- ==================== §05 预报 vs 实况 ==================== -->
  <section class="card" id="vs">
    <p class="eyebrow">§05 · 亲眼看看</p>
    <h2>最近 72 小时：预报 vs 实况</h2>
    <p class="desc">黑线 = 气象站实测气温，彩线 = 所选预报源；灰蓝宽柱 = 站点实测降水，
      实心窄柱 = <b>该源同时刻的预报降水</b>（右轴）——两根柱子对得越齐，降雨时段报得越准。</p>
    <div class="controls">
      <label for="tsStation">站点</label><select id="tsStation" aria-label="选择站点"></select>
      <label for="tsModel">预报源</label><select id="tsModel" aria-label="选择预报源"></select>
    </div>
    <div id="chartTs" class="chart"></div>
  </section>

  <!-- ==================== §06 分站对比 ==================== -->
  <section class="card" id="stations">
    <p class="eyebrow">§06 · 亲眼看看</p>
    <h2>同一个预报，在不同站点的表现</h2>
    <p class="desc">选一家预报源，看它在各观测站的表现差异（地形、气候不同会有差异）；
      指标下拉含温度、降水两族的全部已评测指标，虚线 = 全体源在该站的中位水平。
      坐标轴按指标类型取刻度：百分比 0~100、评分 0~1、误差从 0 起、MBE 正负对称、BIAS 标出「=1 正好」。</p>
    <div class="controls">
      <label for="stModel">预报源</label><select id="stModel" aria-label="选择预报源"></select>
      <label for="stMetric">指标</label><select id="stMetric" aria-label="选择指标"></select>
    </div>
    <div id="chartStation" class="chart"></div>
  </section>

  <!-- ==================== 深挖：机制 + 词典 ==================== -->
  <section class="card" id="method">
    <details class="fold" style="margin-top:0"><summary>⚙️ 这份报告是怎么来的（机制 · 口径 · 可审计性）</summary>
      <div class="fold-body">
        <ol class="steps">
          <li>每天 06:00 / 13:00 / 20:00（北京时）自动抓取 {{ report.meta.stations|length }} 个气象站的实况，以及各家预报源当时发布的起报数据。</li>
          <li>预报一旦发布立即原样封存，等真实天气发生后逐小时对账——先封存、后验证，杜绝"事后改预报"。</li>
          <li>本页每次都用<b>保留期内的全部累计数据</b>重新计算（评估由开源库 cyeva 完成），打开永远是"数据起点至今"的最新结果——总榜<b>跨月累计</b>，每月 1 号不清零、不退回"样本积累中"。</li>
          <li>每月 1 号把上个月冻结成月度归档，回答"那个自然月谁最准"，永久可查（见页脚）。</li>
        </ol>
        <h3>口径与已知差异</h3>
        <p class="why">① <b>天桶按日历对齐</b>：「提前 N 天」= 起报日之后第 N 个自然日，两个口径同窗比较。
          ② <b>有效样本量 n_eff</b> 已扣除时间自相关与跨站相关，直接按站求和会高估约 1.7 倍。
          ③ <b>总榜加权</b>：每个格子按 √(两维有效样本量的较小者) 加权，过薄格子剔出设计。
          ④ <b>逐小时降水口径</b>：各源入库口径不同（原生序列透传 / 雨率近似 / 累计均摊 / 移位标定），
          已在快照与代码中留档并定期标定复核。
          ⑤ <b>日聚合门槛</b>：只在观测与预报两侧当日非缺测小时数都达标（≥{{ report.meta.daily_min_hours }}/24）的天上比较——
          降水全缺测的样本绝不折算成"预报无雨"。
          {% if report.meta.daily_source_fallback %}⑥ <b>逐日预报补位</b>：逐小时够不着的日子用该源自带的逐日预报补位参与按天评估；
          <b>逐小时指标与排行榜永不掺入日预报反推的样本</b>。逐日块只接可信要素（缺测要素整列为 null，绝不折算）；
          只延展了部分要素的源（如中科星图逐日块只接温度），其补位天桶的综合分仍判"缺一即缺"，
          只有温度分可见——覆盖列与分时效榜会把这种情况如实标出。{% endif %}
          {% if report.meta.get('require_complete_snapshots') %}{{ '⑦' if report.meta.daily_source_fallback else '⑥' }}
          <b>残缺快照默认排除</b>：接口只返回部分分片的快照不参与评估{% if report.meta.get('excluded_incomplete') %}（本窗口已排除
          {% for m, n in report.meta.excluded_incomplete.items() %}{{ model_labels.get(m, m) }} {{ n }} 份{% if not loop.last %}、{% endif %}{% endfor %}）{% endif %}。{% endif %}
          {% if report.coverage.first_obs %}{{ '⑧' if report.meta.daily_source_fallback or report.meta.get('require_complete_snapshots') else '⑦' }}
          <b>实况自 {{ report.coverage.first_obs[:10] }} 起接入</b>，覆盖率按各站实际有实况的时段计算。{% endif %}</p>
        {% if integ.get('merkle_root') %}
        <h3>存档完整性（可自行核验）</h3>
        <p class="why">本轮 {{ integ.get('n_snapshots') }} 份存档内容的哈希被聚合成一个 Merkle 根：
          <code style="word-break:break-all">{{ integ.merkle_root }}</code>。
          任何人克隆仓库后运行 <code>python -m weather_eval verify</code> 即可重算比对。
          <b>能力的边界要一并说清</b>：校验会比对"重算的内容哈希"与"封存时盖下的
          内嵌哈希"（{% if integ.get('n_with_embedded_hash') %}{{ integ.get('n_with_embedded_hash') }} 份带内嵌哈希{% else %}本窗口无{% endif %}），
          因此误操作编辑、git 冲突残留、工具链自动格式化都能被抓到；
          但"改内容 + 正确重算哈希 + 重跑报告刷新清单"这条完整攻击链<b>抓不到</b>——
          堵住它需要仓库之外的不可变锚点（根另行留档或签名），本项目目前没有做。</p>
        {% endif %}

        <details class="fold" style="margin-top:14px"><summary>🔬 这份名次有多结实？——诊断层的硬数字</summary>
          <div class="fold-body">
          {% if not diag.get('available') %}
            <p class="why">诊断层本轮不可用（{{ diag.get('reason', '未提供原因') }}）。</p>
          {% else %}
            {% set sc = diag.get('source_correlation') or {} %}
            {% if sc.get('available') %}
            <h3>同榜的 {{ sc.get('n_models') }} 家，其实是几份独立证据？</h3>
            <p class="why">各家预报的是<b>同一批天气系统</b>，它们的误差天然高度相关。
              实测两两相关均值 ρ̄ = <b>{{ sc.get('mean_rho') }}</b>，
              按 k_eff = m/(1+(m−1)ρ̄) 折算后的<b>有效独立信源数约 {{ sc.get('k_eff') }} 家</b>
              ——榜单上看上去是 {{ sc.get('n_models') }} 份证据，折算后只相当于约
              {{ sc.get('k_eff') }} 份。这直接决定"第一名领先第二名"这句话的含金量。
              {% if report.meta.get('holm') and report.meta.holm.get('k_eff') %}
              显著性检验（† 标记）当前用的是<b>{{ 'k_eff 折算口径' if report.meta.holm.mode == 'k_eff' else '保守口径 m' }}</b>
              （m = {{ report.meta.holm.m }}，k_eff = {{ report.meta.holm.k_eff }}）：
              保守口径宁可多说"说不清"，因为往 k_eff 方向放松会<b>增加</b>被判"与冠军有显著差异"的家数。
              {% endif %}</p>
            {% endif %}

            {% set br = diag.get('bridge') or {} %}
            {% if br.get('available') %}
            <h3>留一源：这张榜是不是被一两家撑着？</h3>
            <p class="why">逐个剔除入设计的源重算总榜，看名次怎么动。
              本轮参与桥接的源 {{ br.get('n_bridge') }}/{{ br.get('n_models') }} 家。
              {% set jw = (br.get('jackknife') or {}).get('worst') or None %}
              {% if jw and jw.get('model') %}
              对名次影响最大的一家：{{ model_labels.get(jw.get('model'), jw.get('model')) }}
              （剔掉后与冠军的名次相关性 {{ jw.get('spearman') }}、前十换 {{ jw.get('top10_changed', 0) }} 家）。
              {% elif br.get('n_bridge') == br.get('n_models') %}
              全部源都跨越两条轨道，榜不由任何少数桥梁源单独撑起。
              {% endif %}</p>
            {% endif %}

            {% set co = diag.get('corridor') or {} %}
            {% if co.get('available') and co.get('corridors') %}
            <h3>口径走廊：换一套入围门槛，名次还站得住吗？</h3>
            <p class="why">敏感性分析此前只扰动权重；这里扰动的是<b>哪些样本算数</b>
              （n_eff 入围门槛、格子权重门槛等）。</p>
            {% set fid = br.get('fidelity') or {} %}
            {% if fid and fid.get('spearman') is not none %}
            {% if fid.get('spearman') < 0.9 %}
            <p class="warn-badge">⚠️ 重建与正式总榜的保真度仅 {{ fid.get('spearman') }}（&lt;0.9），
              下面这张走廊表的结论不可引用。</p>
            {% else %}
            <p class="fine">走廊基线 = 等权重建设计，与正式总榜名次相关性
              {{ fid.get('spearman') }}{% if fid.get('champion_same') %}
              ，冠军一致{% else %}；基线冠军 {{ model_labels.get(fid.get('champion_rebuilt'), fid.get('champion_rebuilt')) }}
              与正式榜冠军 {{ model_labels.get(fid.get('champion_official'), fid.get('champion_official')) }} 不是同一家，读"冠军是否易主"列时以此为准{% endif %}。</p>
            {% endif %}
            {% endif %}
            <table class="plain">
              <thead><tr><th>被扰动的口径</th><th>取值</th><th>与原本的名次相关</th><th>前十换了几家</th><th>冠军是否易主</th></tr></thead>
              <tbody>
              {% for c in co.get('corridors')[:8] %}
                <tr><td>{{ c.get('param') }}</td><td>{{ c.get('value') }}</td>
                    <td class="num">{{ c.get('spearman') }}</td>
                    <td class="num">{{ c.get('top10_changed') }}</td>
                    <td>{{ '是' if c.get('champion_changed') else '否' }}</td></tr>
              {% endfor %}
              </tbody>
            </table>
            {% endif %}

            {% set fp = diag.get('fingerprint') or {} %}
            {% if fp.get('models') %}
            <h3>指纹漂移：有没有源"接口没坏、口径偷偷变了"？</h3>
            <p class="why">本项目最危险的失效形态是 HTTP 200 + 语义已变：降水从累计变瞬时、
              时间从 UTC 变北京时、返回点数被静默截断。逐轮比对快照契约字段即可发现。
              {% set drifting = [] %}
              {% for m, v in fp.get('models').items() %}{% if v.get('drift') %}{% set _ = drifting.append(m) %}{% endif %}{% endfor %}
              {% if drifting %}本轮检出漂移：<b>{% for m in drifting %}{{ model_labels.get(m, m) }}{% if not loop.last %}、{% endif %}{% endfor %}</b>。
              {% else %}本轮<b>未检出契约字段漂移</b>（覆盖 {{ fp.get('models')|length }} 个源）。{% endif %}</p>
            {% endif %}

            {% set si = diag.get('slope_influence') or {} %}
            {% if si.get('available') %}
            <h3>评分斜率的实测影响力：名义权重 ≠ 实际说了多少话</h3>
            <p class="why">名义权重是写在评分卡里的 25% / 15% / …，但真正推动名次的是
              <b>斜率 × 数据分布</b>：某项指标在实际数据上跨得多大，才决定它能把分拉开多少。
              下表用本轮真实分桶指标估算每项指标 ±1 个标准差能推动多少加权子分——
              这就是它<b>实际</b>的影响力占比。</p>
            <table class="plain">
              <thead><tr><th>维度</th><th>指标</th><th>换算式</th><th>名义权重</th><th>实测分布(均值±SD)</th><th>实际影响力</th><th>名义 vs 实际</th></tr></thead>
              <tbody>
              {% for r in si.get('temp', []) %}
                <tr><td>温度</td><td>{{ r.get('key') }}</td><td class="l">{{ r.get('formula') }}</td>
                    <td class="num">{{ r.get('nominal_weight') }}</td>
                    <td class="num">{{ r.get('metric_mean') }} ± {{ r.get('metric_sd') }}</td>
                    <td class="num">{{ r.get('effective_share') }}</td>
                    <td class="num">×{{ (r.get('effective_share') / r.get('nominal_weight'))|round(2) if r.get('nominal_weight') else '—' }}</td></tr>
              {% endfor %}
              {% for r in si.get('precip', []) %}
                <tr><td>降水</td><td>{{ r.get('key') }}</td><td class="l">{{ r.get('formula') }}</td>
                    <td class="num">{{ r.get('nominal_weight') }}</td>
                    <td class="num">{{ r.get('metric_mean') }} ± {{ r.get('metric_sd') }}</td>
                    <td class="num">{{ r.get('effective_share') }}</td>
                    <td class="num">×{{ (r.get('effective_share') / r.get('nominal_weight'))|round(2) if r.get('nominal_weight') else '—' }}</td></tr>
              {% endfor %}
              </tbody>
            </table>
            <p class="why">斜率本身<b>尚未纳入敏感性走廊</b>（那需要把评分部件参数化，改动面较大）——
              这张表是"这个旋钮有多重"的实测证据，不是"换了斜率名次会怎样"的模拟。
              权重敏感性只扰动权重，扰不到斜率，这一点在 README 的已知缺口里已记明。</p>
            {% endif %}

            {% set sl = report.meta.get('seal_lag') or {} %}
            {% if sl.get('available') %}
            <h3>封存滞后：有没有"实况之后才抓回来"的预报？</h3>
            <p class="why">地基原则是"预报必须在实况之前封存"。本轮检出
              <b>{{ sl.get('n_unfrozen') }}</b> 条有效时刻早于抓取时刻的样本{% if report.meta.get('require_frozen_samples') %}，
              已全部排除出榜{% else %}，<b>未排除</b>（require_frozen_samples 已关闭）{% endif %}。
              这些值可能不是预报而是修订值/实况值——对纯数值模式产品风险低，
              对网页接口源则正是本项目要防的"事后取数"。</p>
            <table class="plain">
              <thead><tr><th>源</th><th>违反条数</th><th>滞后中位数</th><th>最大滞后</th></tr></thead>
              <tbody>
              {% for m, v in (sl.get('by_model') or {}).items() %}
                <tr><td>{{ model_labels.get(m, m) }}</td><td class="num">{{ v.get('n_unfrozen') }}</td>
                    <td class="num">{{ v.get('lag_median_h') }} h</td><td class="num">{{ v.get('lag_max_h') }} h</td></tr>
              {% endfor %}
              </tbody>
            </table>
            {% else %}
            <p class="why"><b>封存时点</b>：本轮未检出"有效时刻早于抓取时刻"的样本。</p>
            {% endif %}
          {% endif %}
          </div>
        </details>
        <p class="why">面向开发者的源健康度看板：<a href="{{ base }}health.html">reports/health.html</a>；
          本页背后全部计算结果（分时效全指标、原始榜单）以 JSON 形式随仓库公开于 <code>data/</code>。</p>
      </div>
    </details>

    <details class="fold"><summary>📖 名词小词典</summary>
      <div class="fold-body">
        <dl class="glossary">
          <div><dt>起报 / 起报快照</dt><dd>预报发布的那一刻叫"起报"。每次起报的"未来 16 天逐小时预报"原样存档封存，等真实天气发生后对账——预报不能事后改，检验才算数。</dd></div>
          <div><dt>时效（提前 N 天）</dt><dd>有效时刻 − 起报时刻 = "提前多久做的预报"，按日历天分桶；每个桶里同难度比较。</dd></div>
          <div><dt>综合得分 / 温度分 / 降水分</dt><dd>多个指标压缩成 0~100：温度 7 项、降水 5 项加权，综合 = 两者各半；缺项按剩余权重折算。</dd></div>
          <div><dt>难度对齐（总榜）</dt><dd>先把每一档提前量有多难算出来、统一扣掉再比（双向加法模型），能报 3 天的和能报 15 天的同榜也不吃亏。</dd></div>
          <div><dt>覆盖时效</dt><dd>该源实际参与计算的样本最长覆盖到提前第几天。温度维与降水维分别核计：榜上数字取两维最远值，两维不一致时括注各自的天数（逐日预报块通常只延展温度维，如中科星图温度至 16 天、降水仍止于逐小时的 5 天）。可用时效越少，总榜平均所依据的"桶"越少。</dd></div>
          <div><dt>90% 置信区间与 †</dt><dd>对评估窗口内的<b>天</b>做分块重采样 {{ report.meta.bootstrap_runs }} 次重算榜单得到的波动范围。名字带 <b>†</b> = 与第一名的差距经 Holm–Bonferroni 校正后仍与 0 分不开——不宜过度解读名次先后。</dd></div>
          <div><dt>有效样本量 n_eff</dt><dd>逐小时误差强自相关，名义 n 会把同一信息重复计数；n_eff 按"每天真正带来多少新信息"折算，跨源比较请以它为准。</dd></div>
          <div><dt>RMSE / MAE / MBE</dt><dd>温度误差的典型大小（°C，越小越好）：RMSE 对偶发大误差惩罚更重；MAE 是最朴素的"平均差多少度"；MBE 正 = 习惯性报偏高，负 = 报偏低。</dd></div>
          <div><dt>相关系数 r / 回归斜率</dt><dd>r 越接近 1 越能跟上天气的"节奏"；斜率 &gt;1 = 起伏幅度偏小（该热不热），&lt;1 = 反应过激。</dd></div>
          <div><dt>准确率（±1°C / ±2°C）</dt><dd>预报与实况相差不超过 1°C（或 2°C）的样本占比，越高越好。</dd></div>
          <div><dt>命中率（POD）/ 空报率（FAR）</dt><dd>POD：真下雨的次数里预报也报出的比例（越高越好）；FAR：报了雨却没下的比例（"狼来了"次数，越低越好）。</dd></div>
          <div><dt>TS / ETS 评分</dt><dd>命中 ÷（命中 + 空报 + 漏报），0~1，同时奖励报中、惩罚误报；ETS 对"瞎蒙也能蒙对"做过随机命中校正，更公平。</dd></div>
          <div><dt>频率偏差（BIAS）</dt><dd>报雨次数 ÷ 实际下雨次数。=1 频率正好；&gt;1 爱报雨；&lt;1 不爱报雨。</dd></div>
          <div><dt>日雨评分（TS/ETS）</dt><dd>降水分的口径是北京时自然日 24h 累计雨量 ≥{{ report.meta.rain_daily_threshold_mm }}mm 记"有效降水日"（业务惯用口径）；24h 累计让毛毛雨超报在求和中自然抵消。</dd></div>
          <div><dt>观测覆盖率</dt><dd>评估窗口内成功抓到实况的小时占比（实况接入前的时段不算缺失）；本窗口实况自 {{ report.coverage.first_obs[:10] if report.coverage.first_obs else '—' }} 起。</dd></div>
        </dl>
      </div>
    </details>
  </section>

  <!-- ==================== 页脚：归档 ==================== -->
  {% if archives %}
  <section class="card">
    <p class="eyebrow">🗂️ 月度归档</p>
    <h2>历史月份的冻结档案</h2>
    <p class="desc">每月 1 号（北京时）自动把上个月冻结为永久档案：</p>
    <div class="archive-list">
      {% for a in archives %}<a href="{{ base }}monthly/{{ a }}.html">📦 {{ a }}</a>{% endfor %}
    </div>
  </section>
  {% endif %}

</div>

<footer>
  生成时间：{{ generated_at }}（北京时）｜ 预报源：Open-Meteo（多模型）· 彩云天气 · 和风天气 · 中科天机 · 伏羲 · 风乌 ·
  中科星图 · AccuWeather ｜ 实况：环境气象数据服务平台 eia-data.com<br>
  本页由 GitHub Actions 自动生成，每天 3 次更新；仅供学习参考，出行请以官方气象部门预报为准。
  {% if integ.get('merkle_root') %}<div class="merkle">Merkle root {{ integ.merkle_root }}</div>{% endif %}
</footer>

<script>
/* ==========================================================================
 * 报告数据与绘图
 * 服务端已渲染：榜单表格、走势线、Hero 曲线。本脚本只负责三件事：
 *   1. 榜单表格的列排序（渐进增强）；
 *   2. 五张 ECharts 图（全部"战场带 + 中位线 + 前三名粗线"同构，图例选源）；
 *   3. 下拉/页签的联动。
 * 数据为 render._slim_report 的精简视图；每个图表块套 try/catch，单图出错不
 * 影响页面其余部分。
 * ========================================================================== */
const report = {{ slim_json | safe }};
const MODEL_LABEL = {{ model_labels_json | safe }};
const MODEL_COLOR = {{ model_colors_json | safe }};
const MODEL_FAMILIES = {{ model_families_json | safe }};
const STATION_LABEL = {{ station_labels_json | safe }};

const labelOf = m => MODEL_LABEL[m] || m;
const colorOf = m => MODEL_COLOR[m] || "#68778f";
const stationOf = s => STATION_LABEL[s] || s;
const escHtml = s => String(s == null ? "" : s).replace(/[&<>"']/g,
  c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = (v, d = 1) => (v === null || v === undefined) ? "—" : Number(v).toFixed(d);

const R = report;
const BOARD = R.board || [];
const RANKED = BOARD.map(r => r.m);                    // 总榜名次序
const TOP3 = RANKED.slice(0, 3);
const DAYS = 16;
const BUCKETS = Array.from({length: DAYS}, (_, i) => (i + 1) + "d");
const HAS_ECHARTS = typeof echarts !== "undefined";
const charts = [];
/* 窄屏（手机）判定：与 CSS 的 @media (max-width:760px) 保持同一断点。
   它影响的是图表的"排版取舍"——右侧给线尾名签留的 96px 留白在手机上等于
   白白吃掉四分之一画布，热力图则要改配一条日期滑块。 */
const SMALL = window.matchMedia("(max-width: 760px)").matches;
/* 折线图右侧留白：宽屏给线尾名签留 96px，窄屏没有名签就不该留。 */
const GRID_R = SMALL ? 14 : 96;

function chart(elId) {
  const el = document.getElementById(elId);
  if (!el) return null;
  if (!HAS_ECHARTS) {
    el.innerHTML = '<div class="chart-fallback">图表库未能加载——上方榜单与结论不受影响。</div>';
    return null;
  }
  // 复用已有实例：§04 会按行数动态改容器高度，重复 init 会丢失实例并泄漏
  const c = echarts.getInstanceByDom(el) || echarts.init(el);
  if (!charts.includes(c)) charts.push(c);
  return c;
}
window.addEventListener("resize", () => charts.forEach(c => c.resize()));

/* ECharts 公共样式：观测簿蓝墨水 */
const AXIS = {axisLine: {lineStyle: {color: "#c6d0dd"}}, axisTick: {show: false},
              axisLabel: {color: "#68778f", fontSize: 11}};
const YAXIS = Object.assign({}, AXIS, {type: "value",
  splitLine: {lineStyle: {color: "#e8edf3"}}});
const TIP = {trigger: "axis", confine: true,
  backgroundColor: "rgba(12,35,64,.94)", borderWidth: 0,
  textStyle: {color: "#eaf1fb", fontSize: 12}};

/* 真中位（偶数取两中点均值）。§02 战场带与 §06 参考线共用一个定义——
 * 旧实现一处真中位、一处上中位，偶数样本下"虚线 = 中位"自相矛盾（第四轮 P2-11） */
function medianOf(sortedVals) {
  const n = sortedVals.length;
  if (!n) return null;
  const mid = Math.floor((n - 1) / 2);
  return n % 2 ? sortedVals[mid] : (sortedVals[mid] + sortedVals[mid + 1]) / 2;
}

/* 全体源逐档统计：min/max/中位 —— "战场带"的原料 */
function fieldStats(getVal, n) {
  const out = [];
  for (let i = 0; i < n; i++) {
    const vals = [];
    RANKED.forEach(m => {
      const v = getVal(m, i);
      if (v !== null && v !== undefined && !isNaN(v)) vals.push(v);
    });
    if (!vals.length) { out.push(null); continue; }
    vals.sort((a, b) => a - b);
    out.push({lo: vals[0], hi: vals[vals.length - 1], med: medianOf(vals)});
  }
  return out;
}
function bandSeries(stats) {
  return [
    {type: "line", data: stats.map(s => s ? s.lo : null), stack: "band",
     symbol: "none", lineStyle: {opacity: 0}, silent: true, tooltip: {show: false}},
    {type: "line", data: stats.map(s => s ? +(s.hi - s.lo).toFixed(2) : null), stack: "band",
     symbol: "none", lineStyle: {opacity: 0}, silent: true, tooltip: {show: false},
     areaStyle: {color: "rgba(148,163,184,.16)"}},
    {type: "line", data: stats.map(s => s ? +s.med.toFixed(2) : null), symbol: "none",
     lineStyle: {type: "dashed", color: "#94a3b8", width: 1}, silent: true,
     tooltip: {show: false}},
  ];
}
/* 全体模型线：见 modelSeries（选源面板版本，定义在 legendOpt 之后） */
function legendOpt() {
  return {type: "scroll", top: 0, left: 4, right: 4, itemWidth: 14, itemHeight: 8,
          textStyle: {color: "#68778f", fontSize: 11}, pageIconSize: 10,
          animationDurationUpdate: 300};
}

/* ---------------- 选源面板：按源家族分组的复选框，与图例双向同步 ----------------
 * 28 个源挤在滚动图例里逐个点选太费劲——这是"选源不太好选"的根源。面板把源按
 * 家族（Open-Meteo / 商业 API / 天机 / AI 大模型 / CMA）分组，配三个快捷键；
 * 选中集合是图表的唯一事实来源，图例点击的增删会同步回面板复选框。 */
const BY_LABEL = {};
RANKED.forEach(m => { BY_LABEL[labelOf(m)] = m; });
function makePicker(hostId, onChange) {
  const host = document.getElementById(hostId);
  if (!host) return null;
  const fams = MODEL_FAMILIES.filter(f => (f.models || []).some(m => RANKED.includes(m)));
  const orphans = RANKED.filter(m => !fams.some(f => f.models.includes(m)));
  host.innerHTML =
    `<button type="button" class="picker-btn" aria-haspopup="true" aria-expanded="false">` +
    `选源 <b></b> ▾</button>` +
    `<div class="picker-panel" hidden>` +
    `<div class="picker-quick"><button type="button" data-q="top">前三名</button>` +
    `<button type="button" data-q="all">全部</button>` +
    `<button type="button" data-q="none">清空</button></div>` +
    fams.map(f => `<div class="picker-fam">${f.icon || ""} ${escHtml(f.name || "")}</div>` +
      f.models.filter(m => RANKED.includes(m)).map(m =>
        `<label class="picker-item"><input type="checkbox" value="${escHtml(m)}">` +
        `<i class="dot" style="background:${colorOf(m)}"></i>${escHtml(labelOf(m))}</label>`).join("")
    ).join("") +
    (orphans.length ? `<div class="picker-fam">其他</div>` + orphans.map(m =>
      `<label class="picker-item"><input type="checkbox" value="${escHtml(m)}">` +
      `<i class="dot" style="background:${colorOf(m)}"></i>${escHtml(labelOf(m))}</label>`).join("")
      : "") + `</div>`;
  const btn = host.querySelector(".picker-btn");
  const panel = host.querySelector(".picker-panel");
  let sel = new Set(TOP3);
  function sync() {
    btn.querySelector("b").textContent = `${sel.size}/${RANKED.length}`;
    panel.querySelectorAll("input[type=checkbox]").forEach(b => {
      b.checked = sel.has(b.value);
    });
  }
  function apply() { sync(); onChange(sel); }
  btn.addEventListener("click", () => {
    panel.hidden = !panel.hidden;
    btn.setAttribute("aria-expanded", String(!panel.hidden));
  });
  panel.addEventListener("change", e => {
    if (e.target.tagName !== "INPUT") return;
    if (e.target.checked) sel.add(e.target.value); else sel.delete(e.target.value);
    apply();
  });
  panel.addEventListener("click", e => {
    const q = e.target.closest("[data-q]");
    if (!q) return;
    sel = q.dataset.q === "all" ? new Set(RANKED)
        : q.dataset.q === "top" ? new Set(TOP3) : new Set();
    apply();
  });
  document.addEventListener("click", e => {
    if (!host.contains(e.target)) panel.hidden = true;
  });
  sync();
  return {
    get: () => sel,
    // 图例点击 → 面板同步（图例事件只改显隐，不触发 onChange 重绘）
    syncFromLegend: map => {
      sel = new Set(RANKED.filter(m => map[labelOf(m)] !== false));
      sync();
    },
  };
}
/* 选中集合 → ECharts legend.selected 映射 */
function legendSelected(sel) {
  const out = {};
  RANKED.forEach(m => { out[labelOf(m)] = sel.has(m); });
  return out;
}

/* 全体模型线：选中者加粗（选源面板/图例控制显隐），选得少时带线尾名签 */
function modelSeries(getVal, n, {unit = "", digits = 1, sel = null} = {}) {
  const chosen = sel || new Set(TOP3);
  // 线尾名签是宽屏的奢侈品：手机上它会顶出绘图区，改为靠图例认色
  const withTag = chosen.size > 0 && chosen.size <= 8 && !SMALL;
  const series = RANKED.map(m => {
    const on = chosen.has(m);
    return {
      name: labelOf(m), type: "line", data: Array.from({length: n},
        (_, i) => getVal(m, i)),
      symbol: "none", lineStyle: {width: on ? 2.6 : 1,
        color: colorOf(m), opacity: on ? 1 : .8},
      itemStyle: {color: colorOf(m)},
      endLabel: on && withTag ? {show: true, formatter: labelOf(m),
        color: colorOf(m), fontSize: 11, fontWeight: 600, distance: 6} : undefined,
      emphasis: {focus: "series"},
      tooltip: {valueFormatter: v => v == null ? "—" : fmt(v, digits) + unit},
    };
  });
  return {series, selected: legendSelected(chosen)};
}
const X_DAYS = Object.assign({}, AXIS, {type: "category",
  data: BUCKETS.map(b => b.replace("d", "")),
  name: "提前天数", nameTextStyle: {color: "#68778f", fontSize: 11},
  nameGap: 6});

/* ---------------- §02 衰减曲线 ---------------- */
let decayTrack = "hourly", decayDim = "overall", decayPicker = null;
function renderDecay() {
  const c = chart("chartDecay");
  if (!c) return;
  const track = (R.trend || {})[decayTrack] || {};
  const dim = track[decayDim] || {};
  const getVal = (m, i) => ((dim[m] || {})[BUCKETS[i]]);
  const stats = fieldStats(getVal, DAYS);
  const ms = modelSeries(getVal, DAYS, {digits: 1, sel: decayPicker && decayPicker.get()});
  c.setOption({
    textStyle: {fontFamily: getComputedStyle(document.body).fontFamily},
    grid: {left: 8, right: GRID_R, top: 40, bottom: 8, containLabel: true},
    legend: Object.assign(legendOpt(), {selected: ms.selected}),
    tooltip: TIP, xAxis: X_DAYS, yAxis: YAXIS,
    series: [...bandSeries(stats), ...ms.series],
  }, {notMerge: true});
  c.off("legendselectchanged");
  c.on("legendselectchanged", e => decayPicker && decayPicker.syncFromLegend(e.selected));
}
function bindSeg(id, cb) {
  const seg = document.getElementById(id);
  if (!seg) return;
  seg.addEventListener("click", e => {
    const b = e.target.closest("button");
    if (!b || b.classList.contains("on")) return;
    seg.querySelectorAll("button").forEach(x => x.classList.remove("on"));
    b.classList.add("on");
    cb(b.dataset.v);
  });
}

/* ---------------- §03 温度/降水 ---------------- */
const TEMP_METRICS = [
  ["acc2", "±2°C 准确率", "%", 1, "high"], ["acc1", "±1°C 准确率", "%", 1, "high"],
  ["rmse", "RMSE 误差", "°C", 2, "low"], ["mae", "MAE 误差", "°C", 2, "low"],
  ["mbe", "偏差 MBE", "°C", 2, "zero"], ["r", "相关系数 r", "", 2, "high"]];
const RAIN_METRICS = [
  ["ts", "TS 评分", "", 2, "high"], ["ets", "ETS 评分", "", 2, "high"],
  ["pod", "命中率 POD", "%", 1, "high"], ["far", "空报率 FAR", "%", 1, "low"],
  ["bias", "频率偏差 BIAS", "", 2, "one"], ["acc", "晴雨准确率", "%", 1, "high"]];
let wxTrack = "hourly", wxHalf = "max", wxTab = "temp", wxMetric = "acc2", wxPicker = null;
function wxMetrics() { return wxTab === "temp" ? TEMP_METRICS : RAIN_METRICS; }
/* 数据源随口径走：逐小时 = 全量逐小时样本按天分桶；日口径 = 日最高/最低温
 * （两个独立交付量，分开切不合并）与 24h 累计 ≥1mm 晴雨，与日榜同源。 */
function wxSource() {
  if (wxTrack === "daily") {
    return wxTab === "temp" ? (wxHalf === "max" ? (R.tdmax || {}) : (R.tdmin || {}))
                            : (R.rdaily || {});
  }
  return wxTab === "temp" ? (R.temp || {}) : (R.rain || {});
}
function renderWx() {
  const c = chart("chartWx");
  if (!c) return;
  const sel = document.getElementById("wxMetric");
  sel.innerHTML = wxMetrics().map(m =>
    `<option value="${m[0]}"${m[0] === wxMetric ? " selected" : ""}>${m[1]}</option>`).join("");
  const meta = wxMetrics().find(m => m[0] === wxMetric) || wxMetrics()[0];
  const [key, , unit, digits, dir] = meta;
  const note = document.getElementById("wxNote");
  if (note) note.textContent =
    dir === "high" ? "越高越好" : dir === "low" ? "越低越好"
    : dir === "zero" ? "越接近 0 越好" : "越接近 1 越好";
  const halfSeg = document.getElementById("segWxHalf");
  if (halfSeg) halfSeg.hidden = !(wxTrack === "daily" && wxTab === "temp");
  const src = wxSource();
  const getVal = (m, i) => ((src[m] || {})[BUCKETS[i]] || {})[key];
  const stats = fieldStats(getVal, DAYS);
  const ms = modelSeries(getVal, DAYS, {unit, digits, sel: wxPicker && wxPicker.get()});
  c.setOption({
    textStyle: {fontFamily: getComputedStyle(document.body).fontFamily},
    grid: {left: 8, right: GRID_R, top: 40, bottom: 8, containLabel: true},
    legend: Object.assign(legendOpt(), {selected: ms.selected}),
    tooltip: TIP, xAxis: X_DAYS, yAxis: YAXIS,
    series: [...bandSeries(stats), ...ms.series],
  }, {notMerge: true});
  c.off("legendselectchanged");
  c.on("legendselectchanged", e => wxPicker && wxPicker.syncFromLegend(e.selected));
}

/* ---------------- §04 热力图 ---------------- */
/* 指标键 = R.heat 里的矩阵名（温度 ±2°C 矩阵叫 acc，降水晴雨准确率叫 accr）。
 * 与 §03 的两族指标同集合，唯二差别：|MBE| 取绝对值（热力图只表达偏差幅度，
 * 正负号去 §03 看）；BIAS 需以 =1 为参考的双向刻度，不进单色热力图。 */
const HEAT_METRICS = {
  temp: [["acc", "±2°C 准确率", "%", 1, "high"],
         ["acc1", "±1°C 准确率", "%", 1, "high"],
         ["rmse", "RMSE 误差", "°C", 2, "low"],
         ["mae", "MAE 误差", "°C", 2, "low"],
         ["mbe", "|MBE| 偏差", "°C", 2, "low"]],
  rain: [["ts", "时雨 TS", "", 2, "high"],
         ["ets", "时雨 ETS", "", 2, "high"],
         ["accr", "晴雨准确率", "%", 1, "high"],
         ["pod", "命中率 POD", "%", 1, "high"],
         ["far", "空报率 FAR", "%", 1, "low", "空报多", "空报少"]],
};
let heatTab = "temp", heatMetric = "acc";
function heatMetrics() { return HEAT_METRICS[heatTab]; }
function renderHeat() {
  const c = chart("chartHeat");
  if (!c) return;
  const heat = R.heat || {};
  const models = heat.models || [], dates = heat.dates || [];
  if (!models.length || !dates.length) return;
  // 容器高度按行数走：固定 380px 装不下 28 行，类目轴标签会被 auto-interval
  // 整行吞掉（"左边源名显示不全"的根源）——行距给足 + interval:0 双保险。
  const el = document.getElementById("chartHeat");
  el.style.height = Math.max(SMALL ? 420 : 380,
                             models.length * (SMALL ? 22 : 24) + 110) + "px";
  c.resize();
  const selMt = document.getElementById("heatMetric");
  if (!heatMetrics().some(m => m[0] === heatMetric)) heatMetric = heatMetrics()[0][0];
  selMt.innerHTML = heatMetrics().map(m =>
    `<option value="${m[0]}"${m[0] === heatMetric ? " selected" : ""}>${m[1]}</option>`).join("");
  const [key, label, unit, digits, dir] = heatMetrics().find(m => m[0] === heatMetric);
  const nMat = heatTab === "temp" ? (heat.n || []) : (heat.nr || []);
  const cells = [];
  models.forEach((m, y) => ((heat[key] || [])[y] || []).forEach((v, x) => {
    if (v !== null && v !== undefined) cells.push([x, models.length - 1 - y, v]);
  }));
  const vals = cells.map(c2 => c2[2]).sort((a, b) => a - b);
  const showEmpty = !cells.length;
  // 色带范围：百分比指标从样本分布的低分位起步（全 0~100 会把差异压平），
  // 误差类从 0 到观测最大值（越高越红），评分类固定 0~1；低向指标可自带
  // 色带两端文字（如 FAR 的"空报多/空报少"），缺省沿用误差类措辞。
  const [,, , , , loText, hiText] = heatMetrics().find(m => m[0] === heatMetric);
  let vMin, vMax = 100, vText = ["准", "翻车"], inRange = ["#c0492f", "#e0b64f", "#3f9d6a"];
  if (dir === "low") {           // RMSE：低 = 好，色带反向
    vMin = 0;
    vMax = Math.max(1, Math.ceil((vals[vals.length - 1] || 2) * 10) / 10);
    vText = [loText || "误差大", hiText || "误差小"];
    inRange = ["#3f9d6a", "#e0b64f", "#c0492f"];
  } else if (unit === "%") {
    vMin = Math.max(0, Math.floor((vals[Math.floor(vals.length * .06)] || 40) / 5) * 5);
  } else {                       // TS/ETS：0~1
    vMin = 0; vMax = 1;
    vText = ["报得准", "全落空"];
  }
  c.setOption({
    textStyle: {fontFamily: getComputedStyle(document.body).fontFamily},
    // 手机上除色带外再叠一条日期滑块，两者分层摆放（bottom 抬高色带、滑块贴底）
    grid: {left: 8, right: 16, top: 8, bottom: SMALL ? 122 : 52, containLabel: true},
    title: showEmpty ? {text: "该指标本窗口样本不足，暂无格子", left: "center",
      top: "middle", textStyle: {color: "#68778f", fontSize: 13, fontWeight: 400}} : undefined,
    tooltip: Object.assign({}, TIP, {trigger: "item",
      formatter: p => {
        const m = models[models.length - 1 - p.value[1]];
        const n = (nMat[models.length - 1 - p.value[1]] || [])[p.value[0]];
        return `${escHtml(labelOf(m))} · ${dates[p.value[0]]}<br>${label} <b>${p.value[2]}${unit}</b>` +
               (n ? ` · 样本 ${n}` : "");
      }}),
    // 窄屏格子密（约 30 天挤进 300px），写死 interval:2 仍会叠字——交给
    // ECharts 自适应：未放大时它自动隐藏到不重叠，放大后自动补回更多日期。
    xAxis: Object.assign({}, AXIS, {type: "category", data: dates,
      axisLabel: {color: "#68778f", fontSize: 10,
        ...(SMALL ? {} : {interval: 2})}}),
    yAxis: Object.assign({}, AXIS, {type: "category",
      data: models.slice().reverse().map(labelOf),
      axisLabel: {color: "#35455e", fontSize: 11, interval: 0}}),
    // 手机专属：横轴日期缩放滑块（§04 提示词承诺的"拖动看某几天"）。
    // 未放大=看全局色块分布，放大=看某几天的逐源差异；手柄标签显示日期。
    dataZoom: SMALL ? [{type: "slider", xAxisIndex: 0, bottom: 6, height: 22,
      start: 0, end: 100,
      borderColor: "#dce3ec", backgroundColor: "#f7f9fc",
      fillerColor: "rgba(32,95,167,.14)",
      handleStyle: {color: "#205fa7", borderColor: "#205fa7"},
      moveHandleStyle: {color: "#205fa7"},
      dataBackground: {lineStyle: {color: "#c6d0dd"}, areaStyle: {color: "#e8edf3"}},
      selectedDataBackground: {lineStyle: {color: "#205fa7"},
                               areaStyle: {color: "#cfe0f2"}},
      textStyle: {color: "#68778f", fontSize: 10},
      labelFormatter: v => dates[Math.round(v)] || ""}] : [],
    visualMap: {min: vMin, max: vMax, calculable: true, orient: "horizontal",
      left: "center", bottom: SMALL ? 46 : 0, itemHeight: 90, text: vText,
      textStyle: {color: "#68778f", fontSize: 11},
      inRange: {color: inRange}},
    series: [{type: "heatmap", data: cells,
      itemStyle: {borderColor: "#fff", borderWidth: 1},
      emphasis: {itemStyle: {shadowBlur: 4, shadowColor: "rgba(0,0,0,.3)"}}}],
  }, {notMerge: true});
}

/* ---------------- §05 预报 vs 实况 ---------------- */
let tsStation = null, tsModel = null;
/* #RRGGBB → rgba()：预报降水柱用源色半透明，与实况降水的灰蓝宽柱同刻叠画 */
function withAlpha(hex, a) {
  const m = /^#?([0-9a-f]{6})$/i.exec(String(hex || ""));
  if (!m) return `rgba(100,116,139,${a})`;
  const n = parseInt(m[1], 16);
  return `rgba(${n >> 16 & 255},${n >> 8 & 255},${n & 255},${a})`;
}
function renderTs() {
  const c = chart("chartTs");
  if (!c) return;
  const ts = R.ts || {};
  if (!tsStation || !ts[tsStation]) tsStation = Object.keys(ts)[0];
  if (!tsModel || !RANKED.includes(tsModel)) tsModel = RANKED[0];
  const d = ts[tsStation];
  if (!d) return;
  const t = d.t || [];
  const selSt = document.getElementById("tsStation");
  const selMd = document.getElementById("tsModel");
  selSt.innerHTML = Object.keys(ts).map(s =>
    `<option value="${s}"${s === tsStation ? " selected" : ""}>${escHtml(stationOf(s))}</option>`).join("");
  selMd.innerHTML = RANKED.map(m =>
    `<option value="${m}"${m === tsModel ? " selected" : ""}>${escHtml(labelOf(m))}</option>`).join("");
  const src = (d.src || {})[tsModel] || {};
  c.setOption({
    textStyle: {fontFamily: getComputedStyle(document.body).fontFamily},
    grid: {left: 8, right: 8, top: 36, bottom: 8, containLabel: true},
    legend: {top: 0, left: 4, itemWidth: 14, itemHeight: 8,
      textStyle: {color: "#68778f", fontSize: 11},
      data: ["实况气温", labelOf(tsModel), "实况降水", labelOf(tsModel) + " 降水"]},
    tooltip: Object.assign({}, TIP, {axisPointer: {type: "cross",
      crossStyle: {color: "#999"}}}),
    xAxis: Object.assign({}, AXIS, {type: "category", data: t,
      axisLabel: {color: "#68778f", fontSize: 10,
        interval: Math.max(1, Math.ceil(t.length / 8) - 1),
        formatter: v => v.replace("T", "\n")}}),
    yAxis: [Object.assign({}, YAXIS, {name: "°C",
        nameTextStyle: {color: "#68778f", fontSize: 11}}),
      Object.assign({}, YAXIS, {name: "mm", splitLine: {show: false},
        nameTextStyle: {color: "#68778f", fontSize: 11}})],
    series: [
      // 降水两根柱同刻叠画：宽而淡的是实况，窄而实的是预报——柱子对得越齐，
      // 降雨时段报得越准（降水的对错不看绝对量级，看时段与有无）
      {name: "实况降水", type: "bar", yAxisIndex: 1, data: d.obs.r,
       barWidth: "46%", barGap: "-100%", z: 1,
       itemStyle: {color: "rgba(96,148,196,.32)"},
       tooltip: {valueFormatter: v => fmt(v, 1) + " mm"}},
      {name: labelOf(tsModel) + " 降水", type: "bar", yAxisIndex: 1, data: src.r,
       barWidth: "20%", z: 2,
       itemStyle: {color: withAlpha(colorOf(tsModel), .9), borderRadius: [2, 2, 0, 0]},
       tooltip: {valueFormatter: v => fmt(v, 1) + " mm"}},
      {name: "实况气温", type: "line", data: d.obs.t, symbol: "none", z: 3,
       lineStyle: {color: "#0c2340", width: 2},
       tooltip: {valueFormatter: v => fmt(v, 1) + " °C"}},
      {name: labelOf(tsModel), type: "line", data: src.t, symbol: "none", z: 3,
       lineStyle: {color: colorOf(tsModel), width: 2},
       itemStyle: {color: colorOf(tsModel)},
       tooltip: {valueFormatter: v => fmt(v, 1) + " °C"}},
    ],
  }, {notMerge: true});
}

/* ---------------- §06 分站对比 ---------------- */
/* 温度/降水两族全部已评测指标（与 §03 的指标下拉同一集合）。每个指标声明
 * kind —— 纵轴刻度由它决定，不再一刀切"向上取整到 10"：
 *   pct   有界百分数 0~100（诚实刻度，柱顶带数值读差异）
 *   score 有界评分 0~1
 *   abs0  误差类，从 0 到 nice 上取整的数据最大值
 *   zero  可正可负（MBE），正负对称，0 参考线
 *   corr  相关系数，下界含 0（可能为负）、上界 1
 *   one   频率偏差（BIAS），标出 "=1 频率正好" 参考线
 */
const ST_METRICS = [
  ["t", "acc2", "±2°C 准确率", "%", 1, "pct"],
  ["t", "acc1", "±1°C 准确率", "%", 1, "pct"],
  ["t", "rmse", "温度 RMSE", "°C", 2, "abs0"],
  ["t", "mae", "温度 MAE", "°C", 2, "abs0"],
  ["t", "mbe", "偏差 MBE", "°C", 2, "zero"],
  ["t", "r", "相关系数 r", "", 2, "corr"],
  ["r", "ts", "时雨 TS", "", 2, "score"],
  ["r", "ets", "时雨 ETS", "", 2, "score"],
  ["r", "acc", "晴雨准确率", "%", 1, "pct"],
  ["r", "pod", "命中率 POD", "%", 1, "pct"],
  ["r", "far", "空报率 FAR", "%", 1, "pct"],
  ["r", "bias", "频率偏差 BIAS", "", 2, "one"],
];
const ST_GROUPS = [["t", "温度"], ["r", "降水（逐小时 ≥0.1mm 口径）"]];
/* nice 上取整：把自适应轴的最大值收整到 1/1.5/2/2.5/…×10^k，刻度不再怪异 */
function niceMax(v) {
  if (!isFinite(v) || v <= 0) return 1;
  const p = Math.pow(10, Math.floor(Math.log10(v)));
  for (const m of [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10]) {
    if (m * p >= v) return m * p;
  }
  return 10 * p;
}
let stModel = null, stMetric = 0;
function renderStation() {
  const c = chart("chartStation");
  if (!c) return;
  const sts = R.stations || {};
  if (!stModel || !RANKED.includes(stModel)) stModel = RANKED[0];
  const keys = Object.keys(sts);
  if (!keys.length) return;
  const selMd = document.getElementById("stModel");
  selMd.innerHTML = RANKED.map(m =>
    `<option value="${m}"${m === stModel ? " selected" : ""}>${escHtml(labelOf(m))}</option>`).join("");
  if (!ST_METRICS[stMetric]) stMetric = 0;
  const selMt = document.getElementById("stMetric");
  selMt.innerHTML = ST_GROUPS.map(([g, gLabel]) => {
    const opts = ST_METRICS.map((mt, i) => [mt, i]).filter(([mt]) => mt[0] === g);
    if (!opts.length) return "";
    return `<optgroup label="${gLabel}">` + opts.map(([mt, i]) =>
      `<option value="${i}"${i === stMetric ? " selected" : ""}>${mt[2]}</option>`).join("") +
      "</optgroup>";
  }).join("");
  const [dim, key, , unit, digits, kind] = ST_METRICS[stMetric];
  const vals = keys.map(s => {
    const mm = sts[s][stModel] || {};
    return ((mm[dim] || {})[key]);
  });
  const med = (() => {
    const all = [];
    keys.forEach(s => Object.values(sts[s]).forEach(mm => {
      const v = ((mm[dim] || {})[key]);
      if (v !== null && v !== undefined) all.push(v);
    }));
    if (!all.length) return null;
    all.sort((a, b) => a - b);
    return medianOf(all);
  })();
  // 纵轴刻度按指标类型定（见 ST_METRICS 的 kind 注释）。
  // 轴上界把中位参考线一并包进视野——否则参考线悬在轴外画不出来。
  const vv = vals.filter(v => v !== null && v !== undefined).map(Number);
  const vvAll = med !== null ? vv.concat([med]) : vv;
  let ymin = 0, ymax = 1, refLine = null;
  if (!vvAll.length) {
    ymin = 0; ymax = kind === "pct" ? 100 : 1;
  } else if (kind === "pct") {          // 从 0 起（不截断），顶部 nice 取整并封顶 100
    ymin = 0; ymax = Math.min(100, niceMax(Math.max(...vvAll) * 1.12));
  } else if (kind === "score") {        // 同上，封顶 1
    ymin = 0; ymax = Math.min(1, niceMax(Math.max(...vvAll) * 1.12));
  } else if (kind === "abs0") { ymin = 0; ymax = niceMax(Math.max(...vvAll) * 1.12); }
  else if (kind === "zero") {
    const m = niceMax(Math.max(...vvAll.map(x => Math.abs(x))) * 1.15);
    ymin = -m; ymax = m; refLine = {y: 0, label: "0 = 无系统偏差"};
  } else if (kind === "corr") { ymin = Math.min(0, ...vvAll); ymax = 1; }
  else if (kind === "one") {
    ymin = 0; ymax = niceMax(Math.max(...vvAll, 1.25) * 1.1);
    refLine = {y: 1, label: "=1 频率正好"};
  }
  const marks = [];
  if (refLine) marks.push({yAxis: refLine.y, lineStyle: {type: "dashed", color: "#b7791f"},
    label: {formatter: refLine.label, color: "#b7791f", fontSize: 10.5,
      position: "insideEndTop", distance: 4}});
  if (med !== null) marks.push({yAxis: med, lineStyle: {type: "dashed", color: "#94a3b8"},
    label: {formatter: "中位 " + fmt(med, digits), color: "#68778f",
      fontSize: 11, position: "end", distance: 5}});
  c.setOption({
    textStyle: {fontFamily: getComputedStyle(document.body).fontFamily},
    grid: {left: 8, right: 64, top: 36, bottom: 8, containLabel: true},
    tooltip: Object.assign({}, TIP, {trigger: "item"}),
    xAxis: Object.assign({}, AXIS, {type: "category",
      data: keys.map(stationOf), axisLabel: {color: "#35455e", fontSize: 12}}),
    yAxis: Object.assign({}, YAXIS, {name: unit,
      nameTextStyle: {color: "#68778f", fontSize: 11},
      min: ymin, max: ymax}),
    series: [{name: labelOf(stModel) + " " + key, type: "bar",
      data: vals, barWidth: "44%",
      itemStyle: {color: colorOf(stModel), borderRadius: [6, 6, 0, 0]},
      label: {show: true, position: "top", color: "#35455e", fontSize: 11,
        formatter: p => p.value == null ? "—" : fmt(p.value, digits)},
      tooltip: {valueFormatter: v => v == null ? "—" : fmt(v, digits) + unit},
      markLine: marks.length ? {
        silent: true, symbol: "none", data: marks} : undefined,
    }],
  }, {notMerge: true});
}

/* ---------------- 榜单切换（总榜 ⇄ 分时效榜，渐进增强） ----------------
 * 总榜是服务端渲染的（无 JS 可读是硬约束）；切到「提前 N 天」分榜后，把服务端
 * 已按综合分排好序的行数组（R.lb[track][day]）填进同一张表——前端只搬运，
 * 不重算名次与分数，榜单与趋势图同源的性质不破。 */
let lbMode = "all";
const LB_BODY_SERVER = () => document.getElementById("lbBody").innerHTML;
let lbBodyServer = null;      // 首次切换前快照，切回总榜时原样恢复
const SPARK_SVG = {};         // 服务端走势线：从总榜行里收集，分榜行复用
const LB_TS_HEAD = {all: "日雨 TS", hourly: "时雨 TS", daily: "日雨 TS"};
/* 移动端卡片藏掉 thead，列含义全靠 td 的 data-label 生成（见上方媒体查询）。
   分榜的 TS 列沿用桌面的分轨命名（第四轮 P1-3 的教训：总榜与日口径的 TS
   数值不同源，共用一个名字曾被并排误读）。 */
const LB_TS_LABEL = {all: "两轨TS", hourly: "时雨TS", daily: "日雨TS"};
function lbDesc(mode) {
  if (mode === "all") {
    return "难度对齐总榜：先把每一档提前量的难度统一扣掉再比（原理见下方折叠区）；" +
      "置信区间与覆盖时效只有总榜有。";
  }
  const [track, day] = mode.split(":");
  if (track === "all") {
    return `综合 · 提前 ${day} 天：小时口径与日口径的分数各半合成（两轨缺一即缺）；` +
      "同一天桶内各家面对同一批天气，直接对照、无覆盖偏差。";
  }
  if (track === "hourly") {
    return `小时口径 · 提前 ${day} 天：逐小时温度 + 该小时 ≥1mm 晴雨；` +
      "同一档内的直接对照，不经难度对齐。";
  }
  return `日口径 · 提前 ${day} 天：日最高/最低温度 + 24h 累计 ≥1mm 晴雨；` +
    "同一档内的直接对照，不经难度对齐。综合分缺任一维即空（缺一即缺），" +
    "只有单维的源仍在该列显示它那一维的分数。";
}
function leadRow(m, rk, s, t, p, a2, ts) {
  const weak = (s === null || s === undefined);
  const c = colorOf(m);
  const v = Math.max(0, Math.min(100, Number(s) || 0));
  const cls = (rk === 1 && !weak ? "is-top " : "") + (weak ? "is-weak" : "");
  // data-label 与服务端总榜行一一对应：移动端卡片没有表头，少了它
  // 六个指标会连成一串裸数字（分榜曾在手机上这样坏了）。
  const tsLab = LB_TS_LABEL[(lbMode.split(":")[0])] || "晴雨TS";
  return `<tr class="${cls}" data-m="${escHtml(m)}" data-rk="${rk}"` +
    ` data-score="${s ?? ""}" data-temp="${t ?? ""}" data-precip="${p ?? ""}"` +
    ` data-acc2="${a2 ?? ""}" data-ts="${ts ?? ""}" data-lead="">` +
    `<td class="c-rk num">${rk}</td>` +
    `<td class="l c-name"><i class="dot" style="background:${c}"></i>` +
    `<b>${escHtml(labelOf(m))}</b>${weak ? '<span class="mid">· 样本积累中</span>' : ""}` +
    `<span class="mid">${escHtml(m)}</span></td>` +
    `<td class="c-score"><div class="cell">` +
    `<div class="thermo sm"><span class="tube"><b style="--v:${v}%"></b></span></div>` +
    `<b class="score-num">${weak ? "—" : fmt(s)}</b></div></td>` +
    `<td data-label="温度">${fmt(t)}</td><td data-label="降水">${fmt(p)}</td>` +
    `<td data-label="±2°C">${a2 == null ? "—" : fmt(a2) + "%"}</td>` +
    `<td data-label="${tsLab}">${fmt(ts, 2)}</td>` +
    `<td data-label="覆盖">—</td><td class="ci-cell" data-label="90%CI">—</td>` +
    `<td class="l c-spark">${SPARK_SVG[m] || ""}</td></tr>`;
}
function renderBoard() {
  const tbody = document.getElementById("lbBody");
  if (!tbody) return;
  if (lbMode === "all") {
    if (lbBodyServer !== null) tbody.innerHTML = lbBodyServer;
  } else {
    const [track, day] = lbMode.split(":");
    const rows = ((R.lb || {})[track] || {})[day] || [];
    tbody.innerHTML = rows.map((r, i) =>
      leadRow(RANKED[r[0]] || "", i + 1, r[1], r[2], r[3], r[4], r[5])).join("");
  }
  const tsHead = document.getElementById("lbTsHead");
  if (tsHead) {
    // 第四轮 P1-3：总榜的 ts 列是小时 TS 与日 TS 拼接后经难度对齐的行效应，
    // 不是"日雨 TS"——同一家在总榜 0.21、日口径 0.61 曾被并排展示而无解释
    tsHead.textContent = lbMode === "all" ? "晴雨 TS（两轨对齐）"
      : lbMode.startsWith("all:") ? "两轨 TS"
      : (LB_TS_HEAD[lbMode.split(":")[0]] || "晴雨 TS");
  }
  const note = document.getElementById("lbNote");
  if (note) note.textContent = lbDesc(lbMode);
}
function bindBoardSwitch() {
  const sel = document.getElementById("lbBoard");
  if (!sel) return;
  // 走势线 SVG 与服务端总榜行先存快照（DOM 一旦被替换就取不到了）
  lbBodyServer = LB_BODY_SERVER();
  document.querySelectorAll("#lbBody tr[data-m]").forEach(tr => {
    const svg = tr.querySelector(".c-spark svg");
    if (svg) SPARK_SVG[tr.dataset.m] = svg.outerHTML;
  });
  const tracks = [["all", "综合"], ["hourly", "小时口径"], ["daily", "日口径"]];
  sel.innerHTML = `<option value="all">总榜 · 难度对齐综合分</option>` +
    tracks.map(([tk, name]) => {
      const days = Object.keys((R.lb || {})[tk] || {}).sort((a, b) => a - b);
      if (!days.length) return "";
      return `<optgroup label="${name} · 按提前天数">` + days.map(d =>
        `<option value="${tk}:${d}">提前 ${d} 天</option>`).join("") + "</optgroup>";
    }).join("");
  sel.addEventListener("change", e => {
    lbMode = e.target.value;
    renderBoard();
  });
}

/* ---------------- 榜单排序（渐进增强） ---------------- */
function bindSort() {
  const ths = document.querySelectorAll("#lbTable th[data-key]");
  ths.forEach(th => th.addEventListener("click", () => {
    const tbody = document.getElementById("lbBody");
    if (!tbody) return;
    const key = th.dataset.key;
    const cur = th.dataset.dir === "asc" ? "desc" : "asc";
    ths.forEach(x => { x.dataset.dir = ""; const i = x.querySelector(".ind");
      if (i) i.textContent = ""; });
    th.dataset.dir = cur;
    const ind = th.querySelector(".ind");
    if (ind) ind.textContent = cur === "desc" ? "▼" : "▲";
    const rows = Array.from(tbody.rows);
    rows.sort((a, b) => {
      const va = a.dataset[key], vb = b.dataset[key];
      if (va === "" && vb === "") return 0;
      if (va === "") return 1;               // 缺值永远垫底
      if (vb === "") return -1;
      return cur === "desc" ? vb - va : va - vb;
    });
    rows.forEach(r => tbody.appendChild(r));
  }));
}

/* ---------------- 启动 ---------------- */
document.addEventListener("DOMContentLoaded", () => {
  bindSort();
  // 选源面板先建（默认选中 = 总榜前三），再首渲染图表
  decayPicker = makePicker("decayPicker", () => renderDecay());
  wxPicker = makePicker("wxPicker", () => renderWx());
  bindBoardSwitch();
  renderDecay(); renderWx(); renderHeat(); renderTs(); renderStation();
  bindSeg("segTrack", v => { decayTrack = v; renderDecay(); });
  bindSeg("segDim", v => { decayDim = v; renderDecay(); });
  bindSeg("segWxTrack", v => { wxTrack = v; renderWx(); });
  bindSeg("segWxHalf", v => { wxHalf = v; renderWx(); });
  bindSeg("segWx", v => {
    wxTab = v;
    wxMetric = (v === "temp" ? TEMP_METRICS : RAIN_METRICS)[0][0];
    renderWx();
  });
  bindSeg("segHeat", v => {
    heatTab = v;
    heatMetric = HEAT_METRICS[v][0][0];
    renderHeat();
  });
  const wxSel = document.getElementById("wxMetric");
  if (wxSel) wxSel.addEventListener("change", e => { wxMetric = e.target.value; renderWx(); });
  const heatSel = document.getElementById("heatMetric");
  if (heatSel) heatSel.addEventListener("change", e => { heatMetric = e.target.value; renderHeat(); });
  const tsSt = document.getElementById("tsStation");
  if (tsSt) tsSt.addEventListener("change", e => { tsStation = e.target.value; renderTs(); });
  const tsMd = document.getElementById("tsModel");
  if (tsMd) tsMd.addEventListener("change", e => { tsModel = e.target.value; renderTs(); });
  const stMd = document.getElementById("stModel");
  if (stMd) stMd.addEventListener("change", e => { stModel = e.target.value; renderStation(); });
  const stMt = document.getElementById("stMetric");
  if (stMt) stMt.addEventListener("change", e => { stMetric = +e.target.value; renderStation(); });
});
</script>
</body>
</html>
