<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>天气预报 API 准确度评估报告门户</title>
<style>
  body { font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; background:#f6f8fb; color:#1f2733; margin:0; }
  header { background:linear-gradient(135deg,#2f6fed,#1f9d55); color:#fff; padding:20px 28px; }
  .wrap { max-width:1000px; margin:0 auto; padding:20px 18px 60px; }
  h2 { border-left:4px solid #2f6fed; padding-left:8px; }
  .card { background:#fff; border:1px solid #e3e8ef; border-radius:12px; padding:16px 18px; margin:16px 0; }
  a { color:#2f6fed; text-decoration:none; } a:hover { text-decoration:underline; }
  ul { line-height:1.9; }
  .muted { color:#6b7785; font-size:13px; }
</style>
</head>
<body>
<header><h1>天气预报 API 准确度评估报告门户</h1>
<div class="muted" style="color:#eef">生成时间：{{ generated_at }}（北京时）</div></header>
<div class="wrap">
  <div class="card">
    <h2>月度报告</h2>
    {% if monthly %}<ul>{% for m in monthly %}<li><a href="monthly/{{ m }}">{{ m.replace('.html','') }} 月度评估报告</a></li>{% endfor %}</ul>
    {% else %}<p class="muted">暂无月度报告（首份完整月报需积累约 1 个月数据）。</p>{% endif %}
  </div>
  <div class="card">
    <h2>每日运行报告（最新在上方）</h2>
    {% if runs %}<ul>{% for r in runs %}<li><a href="runs/{{ r }}">{{ r.replace('.html','') }}</a></li>{% endfor %}</ul>
    {% else %}<p class="muted">暂无运行报告。</p>{% endif %}
  </div>
  <div class="card">
    <h2>最新一键查看</h2>
    <p><a href="latest.html">打开最近一次运行报告 →</a></p>
  </div>
</div>
</body>
</html>
